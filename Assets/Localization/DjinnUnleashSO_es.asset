  m_TableData:
  - m_Id: 33322045440
    m_Localized: "Impacto Tel\xFArico"
    m_Metadata:
      m_Items: []
  - m_Id: 1375277027328
    m_Localized: "Ataca con un golpe elemental capaz de partir la roca e incrementa
      el da\xF1o del ataque f\xEDsico."
    m_Metadata:
      m_Items: []
  - m_Id: 36253863936
    m_Localized: Escudo Terrestre
    m_Metadata:
      m_Items: []
  - m_Id: 1375277027330
    m_Localized: "Despliega una barrera de tierra que reduce a la mitad todo el da\xF1o
      recibido por el grupo durante ese turno."
    m_Metadata:
      m_Items: []
  - m_Id: 1375277027332
    m_Localized: Aliento Abrasador
    m_Metadata:
      m_Items: []
  - m_Id: 1375277027333
    m_Localized: Aumenta el Ataque de todo el grupo usando la furia de las llamas.
    m_Metadata:
      m_Items: []
  - m_Id: 1375277027335
    m_Localized: Llama Delirante
    m_Metadata:
      m_Items: []
  - m_Id: 1375277027336
    m_Localized: "Inflige da\xF1o de fuego al enemigo con probabilidad de provocar
      Desorientaci\xF3n."
    m_Metadata:
      m_Items: []
  - m_Id: 1375277027338
    m_Localized: Corte Huracanado
    m_Metadata:
      m_Items: []
  - m_Id: 1375277027339
    m_Localized: "Golpea al enemigo con un vendaval, a\xF1adiendo da\xF1o de viento
      y con opci\xF3n de realizar un segundo impacto."
    m_Metadata:
      m_Items: []
  - m_Id: 1375277027341
    m_Localized: "Manto Et\xE9reo"
    m_Metadata:
      m_Items: []
  - m_Id: 1375277027342
    m_Localized: Canaliza una suave corriente de aire para aumentar la Resistencia
      Elemental de todo el grupo.
    m_Metadata:
      m_Items: []
  - m_Id: 1375277027344
    m_Localized: Manantial Vital
    m_Metadata:
      m_Items: []
  - m_Id: 1375277027345
    m_Localized: Utiliza el poder del agua para restaurar una cantidad moderada de
      PV a un aliado.
    m_Metadata:
      m_Items: []
  - m_Id: 1375277027347
    m_Localized: Ventisca Entumecedora
    m_Metadata:
      m_Items: []
  - m_Id: 1375277027348
    m_Localized: "Lanza una r\xE1faga de hielo que da\xF1a al enemigo y reduce su
      capacidad de Ataque."
    m_Metadata:
      m_Items: []
