  m_TableData:
  - m_Id: 1448845119488
    m_Localized: "Pr\xF3logo"
    m_Metadata:
      m_Items: []
  - m_Id: 1448857702400
    m_Localized: La furia del Monte Aleph
    m_Metadata:
      m_Items: []
  - m_Id: 1448857702401
    m_Localized: "Una feroz e innatural tormenta descarga su furia sobre la tranquila
      aldea de Tale, a los pies del sagrado Monte Aleph. Mientras los truenos resuenan
      en el valle, los antiguos secretos que yac\xEDan dormidos en las profundidades
      del Templo de Sol comienzan a despertar, amenazando con romper una era de paz."
    m_Metadata:
      m_Items: []
  - m_Id: 1448857702402
    m_Localized: "Cap\xEDtulo I: El Despertar de los Adeptos"
    m_Metadata:
      m_Items: []
  - m_Id: 1448857702403
    m_Localized: La Tormenta sobre Tale
    m_Metadata:
      m_Items: []
  - m_Id: 1448857702404
    m_Localized: "Tres a\xF1os atr\xE1s, una terrible cat\xE1strofe azot\xF3 el pueblo
      de Tale. Tras la ca\xEDda del pe\xF1asco del Monte Aleph, Hans y Garet prometieron
      hacerse m\xE1s fuertes para proteger su hogar."
    m_Metadata:
      m_Items: []
  - m_Id: 1448857702405
    m_Localized: "Cap\xEDtulo II: La Aventura de los Adeptos"
    m_Metadata:
      m_Items: []
  - m_Id: 1448857702406
    m_Localized: El Robo de las Estrellas Elementales
    m_Metadata:
      m_Items: []
  - m_Id: 1448857702407
    m_Localized: "Saturos y Menardi han irrumpido en las ruinas del Templo Sonne
      apoder\xE1ndose de las Estrellas Elementales. Con Kraden y Nadia secuestrados,
      Hans y Garet emprenden su viaje por Weyard para evitar el despertar de la Alquimia."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
