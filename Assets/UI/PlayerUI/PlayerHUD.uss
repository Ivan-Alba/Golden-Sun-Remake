/* =========================================================================
   PlayerHUD.uss
   Styles for Exploration HUD, Dialogues & Persistent Notifications
   ========================================================================= */

/* --- Root Container & Layers --- */
.hud-root {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
}

.hud-layer {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
}

/* =========================================================================
   UNIFIED KEYBOARD KEYCAP BADGES
   Consistent 3D Keycap Styling across Menu (TAB), Party (1-9), and DPAD (Q,E,R,F)
   ========================================================================= */

.hero-key-badge,
.journal-key-badge,
.hud-shortcut-key-badge {
    position: absolute;
    top: -6px;
    left: -6px;
    min-width: 22px;
    height: 22px;
    background-color: var(--color-subbox-bg);
    border-color: var(--color-gold-bright);
    border-width: 1.5px;
    border-bottom-width: 2.5px; /* 3D keycap tactile depth */
    border-radius: 5px;
    padding: 0 5px;
    align-items: center;
    justify-content: center;
}

/* DPAD internal adjustment so badges sit cleanly inside the slots */
.hud-shortcut-key-badge {
    top: 3px;
    left: 3px;
    min-width: 18px;
    height: 18px;
    padding: 0 3px;
    border-bottom-width: 1.5px;
}

.label-key-number,
.label-menu-key,
.label-shortcut-key {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

/* =========================================================================
   LAYER 1: OVERWORLD HUD (ACTIVE EXPLORATION)
   ========================================================================= */

.exploration-layer {
    display: flex; /* Base display mode, toggled dynamically to none in C# */
}

/* --- Top-Left: Journal Menu Prompt (Medallion Style) --- */
.top-left-container {
    position: absolute;
    left: 44px;
    top: 44px;
}

.journal-medallion-prompt {
    align-items: center;
    position: relative;
}

.journal-medallion-frame {
    width: 80px;
    height: 80px;
    border-radius: 32px;
    background-color: var(--color-panel-bg);
    border-color: var(--color-gold-bright);
    border-width: 2.5px;
    align-items: center;
    justify-content: center;
}

.journal-icon {
    width: 80px;
    height: 80px;
    background-image: url("project://database/Assets/Resources/Images/journal_menu.png");
    -unity-background-scale-mode: scale-to-fit;
    border-radius: 4px;
}

/* Key Badge override positioning specifically for the hanging journal prompt */
.journal-key-badge {
    top: auto;
    left: auto;
    bottom: -10px;
}

/* =========================================================================
   TOP-CENTER: LEGEND ZONE BANNER (FANTASY RIBBON STYLE)
   ========================================================================= */

.zone-title-banner-container {
    position: absolute;
    width: 100%;
    top: 36px;
    align-items: center;
    display: none; /* Controlled dynamically in C# */
    opacity: 0;
    transition-property: opacity, translate, scale;
    transition-duration: 0.5s;
    translate: 0 -20px;
    scale: 0.95 0.95;
}

/* Class triggering smooth arrival animation */
.zone-title-banner-container.banner-visible {
    display: flex;
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

/* Banner Container: Celestial fantasy scroll ribbon background */
.zone-title-banner {
    background-color: rgba(12, 18, 32, 0.85); /* Semi-transparent dark slate background */
    border-color: var(--color-gold-bright);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 0;  /* Borderless sides for open ribbon feel */
    border-right-width: 0;
    border-radius: 4px;
    padding: 10px 60px;
    align-items: center;
    min-width: 320px; /* Guarantees elegant width even for short zone names */
}

/* Primary Zone Title */
.label-banner-zone-name {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
    letter-spacing: 3px;
    text-shadow: 2px 2px 6px rgba(0, 0, 0, 0.95);
    margin: 0;
    padding: 0;
}

/* Decorative Golden Divider Layout */
.banner-divider-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    width: 75%;
    margin-top: 6px;
    margin-bottom: 6px;
}

/* Continuous Center Line */
.banner-divider-line {
    flex-grow: 1;
    height: 1.5px;
    background-color: var(--color-gold-sun);
    margin-left: 8px;
    margin-right: 8px;
}

/* Side Flanking Diamonds */
.banner-divider-diamond {
    width: 6px;
    height: 6px;
    background-color: var(--color-gold-bright);
    rotate: 45deg;
    border-width: 1px;
    border-color: #000000;
    flex-shrink: 0;
}

/* Subtitle Region Name */
.label-banner-region-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: #E0E6ED; /* Soft warm white */
    letter-spacing: 1.5px;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
    margin-top: 1px;
    margin-bottom: 2px;
    padding: 0;
    opacity: 0.9;
}

/* =========================================================================
   TOP-RIGHT: GOLDEN COMPASS MINIMAP & QUEST OBJECTIVE
   ========================================================================= */

.top-right-container {
    position: absolute;
    right: 44px;
    top: 44px;
    align-items: flex-end;
}

/* Wrapper aligns the circular minimap and its mounted time badge strictly to center */
.minimap-wrapper {
    align-items: center;
    position: relative;
}

.minimap-frame {
    width: 210px;
    height: 210px;
    align-items: center;
    justify-content: center;
    position: relative;
}

.minimap-viewport {
    width: 176px;
    height: 176px;
    border-radius: 88px;
    border-color: var(--color-gold-sun);
    border-width: 2px;
    background-color: transparent;
    overflow: hidden;
    position: absolute;
}

/* Inner Vignette Shadow Overlay (Cleaned up hard borders) */
.minimap-vignette-overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 88px;
    background-color: transparent;
}

/* Glass Lens Reflection Highlight */
.minimap-glass-reflection {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 88px;
    background-color: transparent;
}

/* Stylized Directional Player Arrow using Sprite */
.minimap-player-arrow {
    width: 12px;
    height: 15px;
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    
    /* Sprite Loading & Tinting */
    background-image: url("project://database/Assets/Resources/Images/Minimap/minimap_arrow.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--color-gold-bright); /* Teñido en dorado claro */
    
    /* Pivot strictly in the visual center for seamless rotation */
    transform-origin: center;
}

.minimap-markers-container {
    width: 100%;
    height: 100%;
    position: absolute;
}

.minimap-compass-ring {
    width: 210px;
    height: 210px;
    border-radius: 105px;
    border-width: 4px;
    border-color: var(--color-gold-sun);
    position: absolute;
    align-items: center;
}

/* Mathematical Absolute Centering for North Indicator on top border */
.minimap-north-indicator {
    position: absolute;
    top: 6px;
    left: 50%;
    translate: -50% 0;
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
    margin: 0;
    padding: 0;
}

/* --- Day/Night Astrological Clock Ring --- */
.day-night-orbit-ring {
    width: 232px;
    height: 232px;
    position: absolute;
    align-items: center;
    justify-content: center;
}

.celestial-body-pivot {
    width: 100%;
    height: 100%;
    position: absolute;
    align-items: center;
    justify-content: flex-start;
}

.sun-moon-icon {
    width: 24px;
    height: 24px;
    border-radius: 12px;
    border-width: 1.5px;
    margin-top: -12px;
}

.sun-moon-icon.icon-sun {
    background-color: var(--color-gold-bright);
    border-color: #D4AC0D;
}

.sun-moon-icon.icon-moon {
    background-color: #F0F3F4;
    border-color: var(--color-accent-blue);
}

/* Mounted Time Badge (Anchored perfectly beneath the Minimap Frame) */
.time-badge-container {
    align-self: center;
    background-color: var(--color-panel-bg);
    border-color: var(--color-gold-sun);
    border-width: 1.5px;
    border-radius: 12px;
    padding: 3px 14px;
    margin-top: -12px; /* Smooth overlap with compass frame */
}

.label-world-time {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

/* Clean Right-Aligned Quest Objective Style */
.quest-objective-box {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    
    background-color: rgba(15, 20, 28, 0.2);
    background-image: none;
    
    border-right-color: var(--color-gold-sun);
    border-right-width: 2px;
    border-top-left-radius: 6px;
    border-bottom-left-radius: 6px;
    
    padding: 2px 10px 2px 5px;
    margin-top: 8px;
    max-width: 360px;
}

.quest-marker-icon {
    width: 8px;
    height: 8px;
    background-color: var(--color-gold-bright);
    rotate: 45deg;
    margin-right: 8px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: #000000;
}

.label-quest-objective {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--color-text-white);
    letter-spacing: 0.5px;
    
    /* Sombras cruzadas para visibilidad sobre fondos claros */
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
    white-space: normal;
    -unity-text-align: middle-right;
    margin: 0;
    padding: 0;
}

/* --- Center Screen: Psynergy Aiming Reticle --- */
.center-aiming-container {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

.aiming-reticle {
    width: 64px;
    height: 64px;
    border-width: 3px;
    border-color: var(--color-gold-bright);
    border-radius: 32px;
    background-color: rgba(255, 215, 0, 0.15);
    display: none; /* Toggled dynamically in C# */
}

/* --- Bottom Center: Stamina Arc/Bar (2D UI) --- */
.bottom-center-stamina-container {
    position: absolute;
    bottom: 110px;
    width: 100%;
    align-items: center;
}

.stamina-bar-background {
    width: 220px;
    height: 12px;
    background-color: var(--color-subbox-bg);
    border-color: var(--color-subbox-border);
    border-width: 1.5px;
    border-radius: 6px;
    overflow: hidden;
    opacity: 0; /* Smooth fade-in/out in C# when stamina drains */
    transition-property: opacity;
    transition-duration: 0.25s;
}

.stamina-bar-fill {
    width: 100%;
    height: 100%;
    background-color: var(--color-accent-blue);
}

/* --- Bottom-Left: Party Quick Status Container & Cards --- */
.bottom-left-party-container {
    position: absolute;
    left: 44px;
    bottom: 44px;
    flex-direction: column;
    align-items: flex-start;
}

/* --- Fantasy Hero Status Card --- */
.hero-status-card {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border);
    border-width: 2px;
    border-top-right-radius: 16px;
    border-bottom-right-radius: 16px;
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    padding: 10px 18px 10px 12px;
    margin-top: 1px;
    position: relative;
    align-self: flex-start;
    overflow: visible; /* Guarantees keycap badge does not get clipped */
    scale: 0.85;
    transform-origin: left bottom;
    transition-property: scale, border-color, background-color;
    transition-duration: 0.2s;
}

.hero-status-card.active-hero {
    border-color: var(--color-gold-bright);
    background-color: var(--color-hover-subtle-bg);
    scale: 0.9;
}

/* Rhombus/Beveled Portrait Frame */
.hero-portrait-frame {
    width: 80px;
    height: 80px;
    border-radius: 14px;
    border-top-left-radius: 22px; /* Asymmetric cut for a sharp fantasy look */
    border-bottom-right-radius: 22px;
    border-width: 2.5px;
    border-color: var(--color-gold-sun);
    background-color: var(--color-subbox-bg);
    overflow: hidden;
    margin-right: 16px;
}

.hero-portrait-img {
    width: 100%;
    height: 100%;
}

/* Info Block Layout */
.hero-info-block {
    flex-direction: column;
    justify-content: center;
}

.hero-header-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 6px;
}

.label-hud-hero-name {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
    margin-right: 12px;
    padding: 0;
}

.label-hud-hero-level {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--color-text-white);
    margin-right: 12px;
    padding: 0;
}

.status-effects-container {
    flex-direction: row;
    align-items: center;
}

.hero-status-effect-icon {
    width: 16px;
    height: 16px;
}

/* Stats Container: Row-by-Row Layout guarantees 100% Alignment */
.hero-stats-rows-container {
    flex-direction: column;
}

.hud-stat-single-row {
    flex-direction: row;
    align-items: center; /* Centers Label, Bar, and Value on the exact same horizontal axis */
    margin-bottom: 5px;
}

.hud-stat-type-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-text-muted);
    width: 24px; /* Fixed width prevents shifting */
    margin-right: 8px;
    padding: 0;
}

.hud-bar-bg {
    width: 150px; /* Width of the bar */
    height: 13px;  /* Bar height */
    background-color: var(--color-subbox-bg);
    border-color: var(--color-subbox-border);
    border-width: 1.5px;
    border-radius: 4px;
    margin-right: 12px;
    overflow: hidden;
}

.hud-bar-hp-fill {
    width: 100%;
    height: 100%;
    background-color: #2ECC71;
}

.hud-bar-pp-fill {
    width: 100%;
    height: 100%;
    background-color: var(--color-accent-blue);
}

.hud-stat-value-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-text-white);
    width: 56px; /* Fixed width for right-aligned numerical values */
    -unity-text-align: middle-right;
    padding: 0;
}

/* Right Rhombus Element Gem (Venus/Mars Star) */
.hero-element-gem {
    width: 28px;
    height: 28px;
    margin-left: 16px;
    rotate: 45deg;
    border-width: 2px;
    border-color: var(--color-gold-bright);
    background-size: cover;
}

/* --- Bottom-Right: D-Pad Shortcuts (Wheel) --- */
.bottom-right-shortcuts-container {
    position: absolute;
    right: 44px;
    bottom: 44px;
}

.dpad-hud-wheel {
    width: 180px; /* Scaled up base dimensions */
    height: 180px;
    position: relative;
    align-items: center;
    justify-content: center;
}

.dpad-hud-wheel.passive-dpad {
    opacity: 0.35;
    scale: 0.95;
    transition-property: opacity, scale;
    transition-duration: 0.25s;
}

.dpad-hud-wheel.aiming-active {
    opacity: 1.0;
    scale: 1.08; /* Scales dynamically on aiming */
    transition-property: opacity, scale;
    transition-duration: 0.15s;
}

.hud-shortcut-slot {
    width: 52px;
    height: 52px;
    position: absolute;
    background-color: var(--color-panel-bg);
    border-color: var(--color-gold-sun);
    border-width: 2px;
    border-radius: 10px;
    align-items: center;
    justify-content: center;
}

.slot-up { top: 0; }
.slot-down { bottom: 0; }
.slot-left { left: 0; }
.slot-right { right: 0; }

.hud-shortcut-icon {
    width: 38px;
    height: 38px;
}

.dpad-hud-center-gem {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: var(--color-gold-bright);
    border-width: 1.5px;
    border-color: #000000;
}

/* --- World to Screen Interaction Prompts Container --- */
.world-interaction-prompts-container {
    width: 100%;
    height: 100%;
    position: absolute;
}

/* =========================================================================
   LAYER 2: DIALOGUES & NARRATIVE
   ========================================================================= */

.dialogue-layer {
    justify-content: flex-end;
    align-items: center;
    padding-bottom: 50px;
    display: none; /* Toggled in C# during interactions */
}

.dialogue-box-container {
    width: 85%;
    max-width: 1200px;
    flex-direction: row;
    align-items: flex-end; /* Align bottom edges of portrait and box */
}

/* Standalone Portrait Frame */
.dialogue-portrait-frame {
    width: 140px;
    height: 140px;
    border-top-left-radius: 24px;      /* Asymmetric fantasy cut */
    border-bottom-right-radius: 24px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    background-color: var(--color-subbox-bg);
    border-color: var(--color-gold-bright);
    border-width: 3px;
    margin-right: 20px;
    flex-shrink: 0;
    overflow: hidden;
}

.dialogue-portrait-img {
    width: 100%;
    height: 100%;
}

/* Main Dialogue Box */
.dialogue-text-box {
    flex-grow: 1;
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border);
    border-width: 2.5px;
    border-radius: 14px;
    padding: 26px 32px;
    min-height: 120px;
    justify-content: flex-start; /* Fixes text origin to the top instead of vertical center */
    position: relative;
}

/* Speaker Name Badge: Anchored consistently to top-left of text box */
.dialogue-name-badge {
    position: absolute;
    top: -16px;
    left: 28px;
    background-color: var(--color-subbox-bg);
    border-color: var(--color-gold-sun);
    border-width: 2px;
    border-radius: 8px;
    padding: 4px 18px;
}

.label-speaker-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
    margin: 0;
    padding: 0;
}

.label-dialogue-text {
    font-size: 20px;
    color: var(--color-text-white);
    white-space: normal;
    margin: 0;
}

.dialogue-next-prompt {
    position: absolute;
    bottom: 14px;
    right: 18px;
    width: 14px;
    height: 14px;
    background-color: var(--color-gold-bright);
    rotate: 45deg;
}

/* =========================================================================
   DIALOGUE CHOICES SYSTEM (MODULAR MENU CONTAINER & ITEMS)
   ========================================================================= */

/* Main Choices Container: Anked cleanly to the top-right inside the dialogue text box */
.dialogue-choices-container {
    position: absolute;
    bottom: 125px;
    right: 15px;
    
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border);
    border-width: 2px;
    border-radius: 8px;
    padding: 8px 10px;
    min-width: 200px;
    display: flex;
    flex-direction: column;
    
    transition-property: opacity, scale;
    transition-duration: 0.15s;
}

/* Modifier class for binary choices (Yes/No) */
.dialogue-choices-container.binary-mode {
    flex-direction: row;
    justify-content: space-around;
    min-width: 160px;
}

/* Individual Choice Item Root */
.dialogue-choice-item {
    flex-direction: row;
    align-items: center;
    padding: 6px 10px;
    border-radius: 4px;
    cursor: link;
    transition-property: background-color;
    transition-duration: 0.1s;
}

/* Hover effect for mouse navigation on PC */
.dialogue-choice-item:hover {
    background-color: var(--color-hover-subtle-bg);
}

/* Active/Keyboard/Gamepad Selected State (Clean background tint instead of harsh borders) */
.dialogue-choice-item.selected {
    background-color: rgba(241, 196, 15, 0.2);
}

/* Classic Golden Sun Diamond Indicator */
.dialogue-choice-selector {
    width: 7px;
    height: 7px;
    background-color: var(--color-gold-bright);
    rotate: 45deg;
    margin-right: 10px;
    flex-shrink: 0;
    border-width: 1px;
    border-color: #000000;
    visibility: hidden; /* Hidden by default */
}

.dialogue-choice-item.selected .dialogue-choice-selector {
    visibility: visible;
}

/* Choice Text Label Style */
.label-choice-text {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--color-text-white);
    margin: 0;
    padding: 0;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.9);
}

.dialogue-choice-item:hover .label-choice-text,
.dialogue-choice-item.selected .label-choice-text {
    color: var(--color-gold-bright);
}

/* =========================================================================
   LAYER 3: PERSISTENT NOTIFICATIONS (GLOBAL)
   ========================================================================= */

.notifications-layer {
    justify-content: center;
    align-items: flex-end;
    padding-right: 44px; /* Matches top-right 44px screen margin */
}

.notifications-stream-container {
    width: 420px;
    flex-direction: column-reverse; /* New notifications appear dynamically at the bottom */
    align-items: flex-end;
}

/* Notification Card Base */
.hud-notification-card {
    flex-direction: row;
    align-items: center;
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border);
    border-width: 2px;
    border-top-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    padding: 12px 18px;
    margin-top: 12px;
    position: relative;
    overflow: hidden;
    width: 390px;
    
    /* Smooth CSS animations for fade-in/out and slide from right in C# */
    transition-property: opacity, scale, translate;
    transition-duration: 0.3s;
}

/* Left Accent Line according to Notification Type */
.notification-type-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 5px;
    background-color: var(--color-gold-bright);
}

.notification-type-accent.accent-item {
    background-color: #2ECC71; /* Green for Items */
}

.notification-type-accent.accent-quest {
    background-color: var(--color-gold-bright); /* Gold for Quests/Log */
}

.notification-type-accent.accent-psynergy {
    background-color: var(--color-accent-blue); /* Blue for Psynergy/Magic */
}

.notification-type-accent.accent-warning {
    background-color: #E74C3C; /* Red for Danger/System Warnings */
}

/* Additional Type-Based Accent Classes for Notifications */
.notification-type-accent.accent-key-item {
    background-color: #9B59B6; /* Purple for Key Items */
}

.notification-type-accent.accent-levelup {
    background-color: #F1C40F; /* Bright Gold for Level Up */
}

.notification-type-accent.accent-info {
    background-color: #BDC3C7; /* Neutral Light Grey for Information */
}

/* Icon Frame Medallion */
.notification-icon-frame {
    width: 46px;
    height: 46px;
    border-radius: 8px;
    border-width: 2px;
    border-color: var(--color-gold-sun);
    background-color: var(--color-subbox-bg);
    align-items: center;
    justify-content: center;
    margin-left: 6px;
    margin-right: 14px;
    flex-shrink: 0;
}

.notification-icon-img {
    width: 100%;
    height: 100%;
    background-size: contain;
    -unity-background-scale-mode: scale-to-fit;
}

/* Text Block Layout */
.notification-text-block {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}

.label-notification-category {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
    letter-spacing: 1px;
    margin: 0;
    padding: 0;
    margin-bottom: 3px;
}

.label-notification-message {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-text-white);
    white-space: normal;
    margin: 0;
    padding: 0;
}