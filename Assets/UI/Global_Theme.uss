:root {
    --color-gold-sun: rgb(218, 165, 32);
    --color-gold-bright: rgb(255, 215, 0);
    --color-text-white: rgb(255, 255, 255);
    --color-text-muted: rgb(138, 155, 168);
    --color-text-description: rgb(203, 213, 225);
    --color-accent-blue: rgb(96, 165, 250);
    --color-panel-bg: rgba(15, 20, 28, 0.85);
    --color-panel-bg-no-alpha: rgb(15, 20, 28);
    --color-panel-border: rgb(46, 58, 78);
    --color-subbox-bg: rgb(16, 23, 34);
    --color-subbox-border: rgb(31, 45, 64);
    --color-hover-subtle-bg: rgba(50, 50, 65, 0.95);
    --color-hover-subtle-border: rgba(218, 165, 32, 0.6);
    --color-hover-gold-bg: rgba(218, 165, 32, 0.35);
    --color-hover-gold-border: rgb(255, 215, 0);
    --color-active-gold-bg: rgba(60, 50, 30, 0.95);
    --color-active-gold-border: rgb(255, 215, 0);
    --color-venus: rgb(200, 138, 46);
    --color-mars: rgb(231, 76, 60);
    --color-jupiter: rgb(155, 89, 182);
    --color-mercury: rgb(52, 152, 219);
    --color-none: rgb(85, 85, 85);
    --color-venus-bg: rgba(200, 138, 46, 0.12);
    --color-mars-bg: rgba(231, 76, 60, 0.12);
    --color-jupiter-bg: rgba(155, 89, 182, 0.12);
    --color-mercury-bg: rgba(52, 152, 219, 0.12);
}

.pip-icon {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    margin-right: 4px;
    border-width: 1px;
    flex-shrink: 0;
}

.pip-count {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(224, 224, 224);
    width: 25px;
}

.icon-venus {
    background-image: url("project://database/Assets/Resources/Images/Icons/Venus_Star.gif?fileID=21300000&guid=f1a0ba108c3adb640bfad36c265184a2&type=3#Venus_Star");
    border-color: rgba(255, 255, 255, 0.4);
}

.icon-mars {
    background-image: url("project://database/Assets/Resources/Images/Icons/Mars_Star.gif?fileID=21300000&guid=f3bd2ce65e9099440a049b566a86e970&type=3#Mars_Star");
    border-color: rgba(255, 255, 255, 0.4);
}

.icon-jupiter {
    background-image: url("project://database/Assets/Resources/Images/Icons/Jupiter_Star.gif?fileID=21300000&guid=2921df73e30678745ba644923a130fa8&type=3#Jupiter_Star");
    border-color: rgba(255, 255, 255, 0.4);
}

.icon-mercury {
    background-image: url("project://database/Assets/Resources/Images/Icons/Mercury_Star.gif?fileID=21300000&guid=94c258c31d4776f429f657c0a79b9112&type=3#Mercury_Star");
    border-color: rgba(255, 255, 255, 0.4);
}

.icon-none {
    background-color: var(--color-none);
    border-color: rgba(255, 255, 255, 0.4);
}

.text-gold {
    color: var(--color-gold-sun);
}

.text-white {
    color: var(--color-text-white);
}

.text-muted {
    color: var(--color-text-muted);
}

.text-accent-blue {
    color: var(--color-accent-blue);
}

.ui-interactive {
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
    transition-timing-function: ease-out;
}

.ui-hover-subtle:hover {
    background-color: var(--color-hover-subtle-bg);
    border-color: var(--color-hover-subtle-border);
}

.ui-hover-gold:hover {
    background-color: var(--color-hover-gold-bg);
    border-color: var(--color-hover-gold-border);
}

.ui-state-active {
    border-color: var(--color-active-gold-border);
    border-width: 2px;
    background-color: var(--color-active-gold-bg);
}

.active-dpad {
}
