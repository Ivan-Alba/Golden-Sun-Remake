                    <ui:VisualElement name="row_gold" picking-mode="Ignore" class="header-info-row row-right">
                        <ui:VisualElement name="icon_gold" class="header-icon icon-gold" />
                        <ui:Label text="40.722 Monedas" name="label_gold" class="label-gold-text" />
                    </ui:VisualElement>
                    <ui:VisualElement name="row_time" picking-mode="Ignore" class="header-info-row row-right">
                        <ui:VisualElement name="icon_time" class="header-icon icon-time" />
                        <ui:Label text="15:23:52" name="label_time" class="label-time-text" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="header_heroes_bar" picking-mode="Ignore" class="header-heroes-bar">
                <ui:Button name="btn_hero0" focusable="false" class="header-hero-card ui-interactive ui-hover-subtle">
                    <ui:VisualElement name="hero_portrait_0" class="header-hero-portrait" />
                    <ui:VisualElement class="header-hero-info">
                        <ui:VisualElement class="header-hero-top-row">
                            <ui:Label name="label_hero_name_0" text="Hans" class="header-hero-name" />
                            <ui:Label name="label_hero_level_0" text="Nv. 1" class="header-hero-level" />
                        </ui:VisualElement>
                        <ui:VisualElement class="header-hero-stats-row">
                            <ui:VisualElement class="header-hero-stat-box">
                                <ui:Label name="label_hero_hp_val_0" text="100/100" class="header-hero-stat-text" />
                                <ui:VisualElement class="header-hero-bar-bg">
                                    <ui:VisualElement name="bar_hero_hp_0" class="header-hero-bar-fill hp-bar-fill" />
                                </ui:VisualElement>
