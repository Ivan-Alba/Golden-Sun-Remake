                <ui:Button name="btn_hero3" focusable="false" class="header-hero-card ui-interactive ui-hover-subtle">
                    <ui:VisualElement name="hero_portrait_3" class="header-hero-portrait" />
                    <ui:VisualElement class="header-hero-info">
                        <ui:VisualElement class="header-hero-top-row">
                            <ui:Label name="label_hero_name_3" text="Mia" class="header-hero-name" />
                            <ui:Label name="label_hero_level_3" text="Nv. 1" class="header-hero-level" />
