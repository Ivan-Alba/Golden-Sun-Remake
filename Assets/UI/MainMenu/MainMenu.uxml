<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenu/MainMenu.uss?fileID=7433441132597879392&amp;guid=d2954fa9e96c5c64ebeb7394ba486812&amp;type=3#MainMenu" />
    <Style src="project://database/Assets/UI/Common_Layouts.uss?fileID=7433441132597879392&amp;guid=cf4db7a79be5e6c4489c6d3eabef35df&amp;type=3#Common_Layouts" />
    <Style src="project://database/Assets/UI/Global_Theme.uss?fileID=7433441132597879392&amp;guid=13e1da8cbe0216544974bb0aa6894e81&amp;type=3#Global_Theme" />
    <ui:VisualElement name="container_book" picking-mode="Ignore" class="container-book">
        <ui:VisualElement name="header_top" picking-mode="Ignore">
            <ui:VisualElement name="header_info_bar" picking-mode="Ignore" class="header-info-bar">
                <ui:VisualElement name="header_left_box" picking-mode="Ignore" class="header-left-box">
                    <ui:VisualElement name="djinn_tracker_row_top" picking-mode="Ignore" class="djinn-tracker-row">
                        <ui:VisualElement name="djinn_group_venus" picking-mode="Ignore" class="djinn-element-group">
                            <ui:VisualElement name="icon_djinn_venus" picking-mode="Ignore" class="header-icon icon-djinn-venus" />
                            <ui:VisualElement name="pips_venus" picking-mode="Ignore" class="djinn-pips-container">
                                <ui:VisualElement class="djinn-pip active" />
                                <ui:VisualElement class="djinn-pip active" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                            </ui:VisualElement>
                            <ui:Label name="label_count_venus" text="(2)" class="djinn-count-text" />
                        </ui:VisualElement>
                        <ui:VisualElement name="djinn_group_mars" picking-mode="Ignore" class="djinn-element-group">
                            <ui:VisualElement name="icon_djinn_mars" class="header-icon icon-djinn-mars" />
                            <ui:VisualElement name="pips_mars" class="djinn-pips-container">
                                <ui:VisualElement class="djinn-pip active" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                            </ui:VisualElement>
                            <ui:Label name="label_count_mars" text="(1)" class="djinn-count-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="djinn_tracker_row_bottom" picking-mode="Ignore" class="djinn-tracker-row">
                        <ui:VisualElement name="djinn_group_jupiter" class="djinn-element-group">
                            <ui:VisualElement name="icon_djinn_jupiter" class="header-icon icon-djinn-jupiter" />
                            <ui:VisualElement name="pips_jupiter" class="djinn-pips-container">
                                <ui:VisualElement class="djinn-pip active" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                            </ui:VisualElement>
                            <ui:Label name="label_count_jupiter" text="(1)" class="djinn-count-text" />
                        </ui:VisualElement>
                        <ui:VisualElement name="djinn_group_mercury" class="djinn-element-group">
                            <ui:VisualElement name="icon_djinn_mercury" class="header-icon icon-djinn-mercury" />
                            <ui:VisualElement name="pips_mercury" class="djinn-pips-container">
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
                                <ui:VisualElement class="djinn-pip" />
