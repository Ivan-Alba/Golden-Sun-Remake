                        <ui:VisualElement class="header-hero-top-row">
                            <ui:Label name="label_hero_name_1" text="Garet" class="header-hero-name" />
                            <ui:Label name="label_hero_level_1" text="Nv. 1" class="header-hero-level" />
                        </ui:VisualElement>
                        <ui:VisualElement class="header-hero-stats-row">
                            <ui:VisualElement class="header-hero-stat-box">
                                <ui:Label name="label_hero_hp_val_1" text="100/100" class="header-hero-stat-text" />
                                <ui:VisualElement class="header-hero-bar-bg">
                                    <ui:VisualElement name="bar_hero_hp_1" class="header-hero-bar-fill hp-bar-fill" />
