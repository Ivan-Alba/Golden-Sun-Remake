                            <ui:VisualElement class="header-hero-stat-box">
                                <ui:Label name="label_hero_pp_val_1" text="50/50" class="header-hero-stat-text" />
                                <ui:VisualElement class="header-hero-bar-bg">
                                    <ui:VisualElement name="bar_hero_pp_1" class="header-hero-bar-fill pp-bar-fill" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="btn_hero2" focusable="false" class="header-hero-card ui-interactive ui-hover-subtle">
                    <ui:VisualElement name="hero_portrait_2" class="header-hero-portrait" />
                    <ui:VisualElement class="header-hero-info">
                        <ui:VisualElement class="header-hero-top-row">
                            <ui:Label name="label_hero_name_2" text="Ivan" class="header-hero-name" />
                            <ui:Label name="label_hero_level_2" text="Nv. 1" class="header-hero-level" />
                        </ui:VisualElement>
                        <ui:VisualElement class="header-hero-stats-row">
                            <ui:VisualElement class="header-hero-stat-box">
                                <ui:Label name="label_hero_hp_val_2" text="100/100" class="header-hero-stat-text" />
                                <ui:VisualElement class="header-hero-bar-bg">
                                    <ui:VisualElement name="bar_hero_hp_2" class="header-hero-bar-fill hp-bar-fill" />
