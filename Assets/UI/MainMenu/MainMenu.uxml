        <ui:VisualElement name="page_content" picking-mode="Ignore" />
        <ui:VisualElement name="control_prompts_bar" class="control-prompts-bar">
            <ui:Label text="[A] / [D] - Cambiar submenú" class="prompt-text" />
            <ui:Label text="[Q] / [E] - Cambiar héroe" class="prompt-text" />
            <ui:Label text="[TAB] - Salir" class="prompt-text" />
        </ui:VisualElement>
        <ui:VisualElement name="bookmarks_bar" picking-mode="Ignore" class="bookmarks-bar">
