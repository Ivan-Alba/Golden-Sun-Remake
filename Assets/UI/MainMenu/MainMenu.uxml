                            <ui:VisualElement class="header-hero-stat-box">
                                <ui:Label name="label_hero_pp_val_2" text="50/50" class="header-hero-stat-text" />
                                <ui:VisualElement class="header-hero-bar-bg">
                                    <ui:VisualElement name="bar_hero_pp_2" class="header-hero-bar-fill pp-bar-fill" />
                                </ui:VisualElement>
