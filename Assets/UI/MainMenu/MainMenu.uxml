                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="header_center_box" picking-mode="Ignore" class="header-center-box">
                    <ui:VisualElement name="row_chapter" picking-mode="Ignore" class="chapter-info-row">
                        <ui:VisualElement name="icon_chapter" class="header-icon icon-chapter" />
                        <ui:Label text="Capítulo I: Las Sombras de Tale" name="label_chapter" class="label-chapter" />
                    </ui:VisualElement>
                    <ui:VisualElement name="row_quest" picking-mode="Ignore" class="header-info-row quest-info-row">
                        <ui:VisualElement name="icon_quest" class="header-icon icon-quest" />
                        <ui:Label text="Reúnete con Kraden al oeste del pueblo" name="label_active_quest" class="label-quest" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="header_right_box" picking-mode="Ignore" class="header-right-box">
                    <ui:VisualElement name="row_location" picking-mode="Ignore" class="header-info-row row-right">
                        <ui:VisualElement name="icon_location" class="header-icon icon-location" />
                        <ui:Label text="Llanura de Tale" name="label_location" class="label-location-text" />
