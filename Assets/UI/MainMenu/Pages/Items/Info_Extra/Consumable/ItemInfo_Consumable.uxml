<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenu/Pages/Items/Info_Extra/Consumable/ItemInfo_Consumable.uss?fileID=7433441132597879392&amp;guid=febc6c31c0a9de24ea484e69c6085cfd&amp;type=3#ItemInfo_Consumable" />
    <Style src="project://database/Assets/UI/Common_Layouts.uss?fileID=7433441132597879392&amp;guid=cf4db7a79be5e6c4489c6d3eabef35df&amp;type=3#Common_Layouts" />
    <Style src="project://database/Assets/UI/Global_Theme.uss?fileID=7433441132597879392&amp;guid=13e1da8cbe0216544974bb0aa6894e81&amp;type=3#Global_Theme" />
    <ui:VisualElement name="consumable_info_root" class="extra-info-card-root">
        <ui:VisualElement name="usage_badges_container" class="badge-row-container">
            <ui:VisualElement name="badge_menu_use" class="item-badge badge-active">
                <ui:VisualElement class="badge-dot" />
                <ui:Label text="MENÚ" name="label_menu_use" class="badge-label" />
            </ui:VisualElement>
            <ui:VisualElement name="badge_battle_use" class="item-badge badge-inactive">
                <ui:VisualElement class="badge-dot" />
                <ui:Label text="COMBATE" name="label_battle_use" class="badge-label" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="info-divider" />
        <ui:VisualElement name="effect_details_box" class="effect-details-box">
            <ui:VisualElement name="effects_header_row">
                <ui:Label text="EFECTOS" class="section-header-title" />
            </ui:VisualElement>
            <ui:VisualElement name="effects_list_container" />
        </ui:VisualElement>
        <ui:VisualElement class="info-divider" />
        <ui:VisualElement name="lore_box" class="lore-box">
            <ui:VisualElement class="quote-mark quote-open" />
            <ui:Label text="Madurada bajo el sol de Vale. Su cáscara dura guarda un sabor dulce y reconfortante." name="label_flavor_text" class="lore-text" />
            <ui:VisualElement class="quote-mark quote-close" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
