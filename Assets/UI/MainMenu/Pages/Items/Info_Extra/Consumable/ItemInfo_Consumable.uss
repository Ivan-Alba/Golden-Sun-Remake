/* =========================================================================
   ItemInfo_Consumable.uss
   Specific Styles for Consumable Items (Dynamic Effect Rows)
   ========================================================================= */

/* --- Block 2 Specifics: Effect Details & Dynamic Rows --- */
.effect-details-box {
    flex-direction: column;
    padding: 2px 4px;
}

.effect-value-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.label-effect-type {
    font-size: 13px;
    color: var(--color-text-description);
}

.label-effect-value {
    font-size: 14px;
    -unity-font-style: bold;
    color: #00FF88; /* Bright green for boosts / healing */
}