/* =========================================================================
   ItemInfo_KeyItem.uss
   Specific Styles for Key / Story Items Details
   ========================================================================= */

/* Golden Border Accent for Key Items Card Root */
.key-item-root-border {
    border-color: rgba(255, 215, 0, 0.25);
}

/* --- Key Item Header Badge --- */
.key-item-badge-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    border-radius: 10px;
    background-color: rgba(255, 215, 0, 0.12);
    border-width: 1px;
    border-color: rgba(255, 215, 0, 0.6);
    margin-bottom: 8px;
}

.key-badge-icon {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background-color: var(--color-gold-bright);
    border-width: 1px;
    border-color: var(--color-gold-sun);
    margin-right: 6px;
}

.key-badge-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
    letter-spacing: 1px;
}