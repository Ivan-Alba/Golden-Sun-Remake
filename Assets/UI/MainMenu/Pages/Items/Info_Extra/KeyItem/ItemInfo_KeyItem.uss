/* =========================================================================
   ItemInfo_KeyItem.uss
   Styles for the modular detail view of Key / Story Items
   ========================================================================= */

.key-item-info-root {
    flex-grow: 1;
    justify-content: flex-start;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 215, 0, 0.25); /* Subtle Golden Border for Key Items */
}

/* --- Key Item Header Badge --- */
.key-item-badge-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    border-radius: 12px;
    background-color: rgba(255, 215, 0, 0.12);
    border-width: 1px;
    border-color: rgba(255, 215, 0, 0.6);
    margin-bottom: 6px;
}

.key-badge-icon {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: #FFD700;
    margin-right: 6px;
}

.key-badge-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: #FFD700; /* Golden Sun Gold */
    letter-spacing: 1px;
    padding: 0;
    margin: 0;
}

/* --- Visual Separator --- */
.info-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.1);
    margin-top: 2px;
    margin-bottom: 8px;
}

/* --- Lore Narrative Box (Flavor Text Style) --- */
.lore-box {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding: 8px 12px;
    background-color: rgba(15, 15, 20, 0.5);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
}

.quote-mark {
    width: 12px;
    height: 2px;
    background-color: rgba(218, 165, 32, 0.5); /* Gold Accent Lines */
    margin-top: 2px;
    margin-bottom: 2px;
}

.lore-text {
    font-size: 11px;
    -unity-font-style: italic;
    color: #D3C399; /* Warm Parchment / Golden Tint */
    -unity-text-align: middle-center;
    white-space: normal;
    line-height: 14px;
    padding: 4px 0;
    margin: 0;
}