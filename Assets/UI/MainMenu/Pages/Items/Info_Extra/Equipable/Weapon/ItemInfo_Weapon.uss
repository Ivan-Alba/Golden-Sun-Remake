/* =========================================================================
   ItemInfo_Weapon.uss
   Styles for the modular detail view of Weapon Artifacts and Standard Weapons
   ========================================================================= */

.weapon-info-root {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
    justify-content: flex-start;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}

.weapon-info-root Label {
    margin: 0;
    padding: 0;
}


/* --- Block 1: Meta Badges (Element, Hit Type, Battle Use) --- */
.weapon-meta-container {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.weapon-badge {
    flex-direction: row;
    align-items: center;
    padding: 4px 10px;
    border-radius: 10px;
    background-color: rgba(20, 20, 20, 0.7);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.badge-icon {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    margin-right: 4px;
    border-width: 1px;
}

.badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    margin-right: 5px;
    background-color: #555555;
}

.badge-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: #888888;
}

/* Specific Hit Type Badge Style */
.badge-hit-type {
    border-color: rgba(255, 255, 255, 0.25);
    background-color: rgba(255, 255, 255, 0.08);
}

.badge-hit-type .badge-label {
    color: #DDDDDD;
}

/* Element Themes */
.badge-element-none {
    border-color: #777777;
    background-color: rgba(100, 100, 100, 0.25);
}
.badge-element-none .badge-label {
    color: #AAAAAA;
}

.badge-element-venus {
    border-color: #C88A2E;
    background-color: rgba(200, 138, 46, 0.25);
}
.badge-element-venus .badge-label {
    color: #F5C572;
}

.badge-element-mars {
    border-color: #E74C3C;
    background-color: rgba(231, 76, 60, 0.25);
}
.badge-element-mars .badge-label {
    color: #FF8E82;
}

.badge-element-jupiter {
    border-color: #9B59B6;
    background-color: rgba(155, 89, 182, 0.25);
}
.badge-element-jupiter .badge-label {
    color: #D7BDE2;
}

.badge-element-mercury {
    border-color: #3498DB;
    background-color: rgba(52, 152, 219, 0.25);
}
.badge-element-mercury .badge-label {
    color: #AED6F1;
}

.badge-active {
    border-color: rgba(255, 215, 0, 0.8);
    background-color: rgba(255, 215, 0, 0.12);
}
.badge-active .badge-dot { background-color: #00FF88; }
.badge-active .badge-label { color: #FFFFFF; }

.badge-inactive { opacity: 0.5; }

/* --- Block 2: Artifact Unleash Section --- */
.unleash-info-box {
    padding: 6px 10px;
    background-color: rgba(255, 215, 0, 0.08);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 215, 0, 0.3);
    margin-bottom: 4px;
}

.unleash-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.unleash-header-title {
    font-size: 12px;
    color: #FFD700;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.unleash-proc-rate {
    font-size: 12px;
    color: #00FF88;
    -unity-font-style: bold;
}

.unleash-body-row {
    flex-direction: row;
    align-items: center;
}

.unleash-icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.4);
    -unity-background-scale-mode: scale-to-fit;
}

.unleash-text-container {
    flex-grow: 1;
    flex-shrink: 1;
}

.unleash-name-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}

/* Adaptación de la Pip para alineación perfecta en la fila del Unleash */
.unleash-element-icon {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    margin-right: 5px;
    border-width: 1px;
    flex-shrink: 0;
}

.unleash-name {
    font-size: 13px;
    color: #FFFFFF;
    -unity-font-style: bold;
}

.unleash-desc {
    font-size: 12px;
    color: #CCCCCC;
    white-space: normal;
}

/* --- Visual Separator --- */
.info-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.1);
    margin-top: 2px;
    margin-bottom: 6px;
}

/* --- Section Titles --- */
.weapon-info-root .section-header-title {
    font-size: 12px;
    color: #DAA520; /* Golden Sun Gold */
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-bottom: 4px;
}

/* --- Block 3: Weapon Base Stats --- */
.stats-box {
    margin-bottom: 2px;
}

.stats-grid {
    flex-direction: column;
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
}

.stat-name {
    font-size: 13px;
    color: #CCCCCC;
}

.stat-value {
    font-size: 14px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

/* --- Block 4: Delta Comparison --- */
.comparison-box {
    margin-top: 2px;
}

.comparison-rows-container {
    flex-direction: column;
}

.comparison-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
}

.delta-container {
    flex-direction: row;
    align-items: center;
}

.current-value {
    font-size: 13px;
    color: #AAAAAA;
}

.weapon-info-root .arrow-separator {
    font-size: 12px;
    color: #666666;
    margin-left: 4px;
    margin-right: 4px;
    padding: 0;
}

.new-value {
    font-size: 14px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.weapon-info-root .delta-tag {
    font-size: 13px;
    -unity-font-style: bold;
    margin-left: 5px;
}

/* Delta States */
.delta-positive { color: #00FF88; } /* Green improvement */
.delta-negative { color: #FF4444; } /* Red downgrade */
.delta-neutral  { color: #888888; } /* Neutral grey */

/* --- Block 5: Narrative Flavor Text (Lore) --- */
.lore-box {
    justify-content: center;
    align-items: center;
    padding: 6px 10px;
    background-color: rgba(15, 15, 20, 0.4);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    margin-top: 2px;
}

.quote-mark {
    width: 12px;
    height: 2px;
    background-color: rgba(218, 165, 32, 0.5); /* Gold Accent Lines */
    margin-top: 2px;
    margin-bottom: 2px;
}

.weapon-info-root .lore-text {
    font-size: 12px;
    -unity-font-style: italic;
    color: #D3C399; /* Warm Parchment / Golden Tint */
    -unity-text-align: middle-center;
    white-space: normal;
    line-height: 15px;
    padding: 3px 0;
}