/* =========================================================================
   ItemInfo_Weapon.uss
   Specific Styles for Weapon Artifacts and Standard Weapons
   ========================================================================= */

/* --- Specific Hit Type Badge Style --- */
.badge-hit-type {
    border-color: rgba(255, 255, 255, 0.25);
    background-color: rgba(255, 255, 255, 0.08);
}

.badge-hit-type .badge-label {
    color: #DDDDDD;
}

/* --- Element Theme Chips (High Specificity Overrides) --- */
.item-badge.badge-element-none { border-color: var(--color-none); background-color: rgba(100, 100, 100, 0.25); }
.item-badge.badge-element-none .badge-label { color: #AAAAAA; }
.item-badge.badge-element-venus { border-color: var(--color-venus); background-color: rgba(200, 138, 46, 0.25); }
.item-badge.badge-element-venus .badge-label { color: #F5C572; }
.item-badge.badge-element-mars { border-color: var(--color-mars); background-color: rgba(231, 76, 60, 0.25); }
.item-badge.badge-element-mars .badge-label { color: #FF8E82; }
.item-badge.badge-element-jupiter { border-color: var(--color-jupiter); background-color: rgba(155, 89, 182, 0.25); }
.item-badge.badge-element-jupiter .badge-label { color: #D7BDE2; }
.item-badge.badge-element-mercury { border-color: var(--color-mercury); background-color: rgba(52, 152, 219, 0.25); }
.item-badge.badge-element-mercury .badge-label { color: #AED6F1; }

/* --- Artifact Unleash Section Specifics --- */
.unleash-info-box {
    padding: 6px 10px;
    background-color: rgba(255, 215, 0, 0.08);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 215, 0, 0.3);
    margin-bottom: 4px;
}

.unleash-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.unleash-header-title {
    font-size: 12px;
    color: var(--color-gold-bright);
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.unleash-proc-rate {
    font-size: 12px;
    color: #00FF88;
    -unity-font-style: bold;
}

.unleash-body-row {
    flex-direction: row;
    align-items: center;
}

.unleash-icon {
    width: 20px;
    height: 20px;
    margin-right: 6px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.4);
    -unity-background-scale-mode: scale-to-fit;
}

.unleash-text-container {
    flex-grow: 1;
    flex-shrink: 1;
}

.unleash-name-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
}
