/* =========================================================================
   ItemInfo_Equipable.uss
   Specific Styles for Standard Equipment Details
   ========================================================================= */

/* --- Element Theme Chips (High Specificity Overrides) --- */
.item-badge.badge-element-none { border-color: var(--color-none); background-color: rgba(100, 100, 100, 0.25); }
.item-badge.badge-element-none .badge-label { color: #AAAAAA; }
.item-badge.badge-element-venus { border-color: var(--color-venus); background-color: rgba(200, 138, 46, 0.25); }
.item-badge.badge-element-venus .badge-label { color: #F5C572; }
.item-badge.badge-element-mars { border-color: var(--color-mars); background-color: rgba(231, 76, 60, 0.25); }
.item-badge.badge-element-mars .badge-label { color: #FF8E82; }
.item-badge.badge-element-jupiter { border-color: var(--color-jupiter); background-color: rgba(155, 89, 182, 0.25); }
.item-badge.badge-element-jupiter .badge-label { color: #D7BDE2; }
.item-badge.badge-element-mercury { border-color: var(--color-mercury); background-color: rgba(52, 152, 219, 0.25); }
.item-badge.badge-element-mercury .badge-label { color: #AED6F1; }

/* --- Active Battle Effect Description Container --- */
.battle-effect-info-box {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 4px;
    padding: 2px 4px;
    background-color: rgba(255, 215, 0, 0.05);
    border-radius: 4px;
}

.sub-header-title {
    font-size: 9px;
    color: var(--color-gold-sun);
    -unity-font-style: bold;
    margin-right: 6px;
}

.battle-effect-text {
    font-size: 10px;
    color: var(--color-text-description);
}