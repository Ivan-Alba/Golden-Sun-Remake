<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/MainMenu/Pages/Items/Info_Extra/ItemInfo_Equipable.uss?fileID=7433441132597879392&amp;guid=121ef9d7908581e4e83846bab7938eb4&amp;type=3#ItemInfo_Equipable" />
    <ui:VisualElement name="equipment_info_root" class="equipment-info-root">
        
        <!-- Block 1: Element & Battle Usage Badges -->
        <ui:VisualElement name="equip_meta_container" class="equip-meta-container">
            <ui:VisualElement name="badge_element" class="equip-badge badge-element-venus">
                <ui:VisualElement name="element_icon" class="badge-icon" />
                <ui:Label text="VENUS" name="label_element_name" class="badge-label" />
            </ui:VisualElement>
            
            <ui:VisualElement name="badge_battle_use" class="equip-badge badge-inactive">
                <ui:VisualElement class="badge-dot" />
                <ui:Label text="USO EN BATALLA" name="label_battle_use" class="badge-label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Optional Row: Active battle effect description (e.g. Healing Ring) -->
        <ui:VisualElement name="battle_effect_info_box" class="battle-effect-info-box">
            <ui:Label text="EFECTO AL USAR:" class="sub-header-title" />
            <ui:Label text="---" name="label_battle_effect_name" class="battle-effect-text" />
        </ui:VisualElement>

        <ui:VisualElement class="info-divider" />

        <!-- Block 2: Item Base Attributes (Populated dynamically from statModifiers via C#) -->
        <ui:VisualElement name="item_stats_box" class="stats-box">
            <ui:Label text="ATRIBUTOS DEL OBJETO" class="section-header-title" />
            <!-- Dynamic container for item stat bonuses -->
            <ui:VisualElement name="stats_grid" class="stats-grid" />
        </ui:VisualElement>

        <ui:VisualElement class="info-divider" />

        <!-- Block 3: Stat Comparison (Populated dynamically for Delta vs Currently Equipped via C#) -->
        <ui:VisualElement name="comparison_box" class="comparison-box">
            <ui:Label text="COMPARATIVA (EQUIPADO)" class="section-header-title" />
            <!-- Dynamic container for delta stat comparison rows -->
            <ui:VisualElement name="comparison_rows_container" class="comparison-rows-container" />
        </ui:VisualElement>

        <ui:VisualElement class="info-divider" />

        <!-- Block 4: Narrative Flavor Text (Lore) -->
        <ui:VisualElement name="lore_box" class="lore-box">
            <ui:VisualElement class="quote-mark quote-open" />
            <ui:Label text="" name="label_flavor_text" class="lore-text" />
            <ui:VisualElement class="quote-mark quote-close" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>