/* ==========================================
   PAGE ITEMS CONTAINER & ROOT LAYOUT (3 VERTICAL PANELS)
   ========================================== */
.page-items-container {
    width: 100%;
    height: 100%;
    max-height: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: row; /* Horizontal 3-column distribution */
    padding: 6px;        /* Slightly tighter padding for better internal fit */
    overflow: hidden;    /* Clips any internal column overflow */
}

/* Common Section Titles (Unified RPG Style Across All 3 Panels) */
.info-title-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: #DAA520; /* Golden section title */
    margin-bottom: 10px;
    margin-top: 4px;
    text-align: center;
    letter-spacing: 1px;
    flex-shrink: 0;
}

/* ==========================================
   LEFT PANEL: EQUIPMENT & PSYNERGY RELICS (25% Width)
   ========================================== */
.equipment-section {
    width: 25%;
    margin-right: 10px;
    background-color: rgba(15, 20, 28, 0.85);
    border-width: 2px;
    border-color: #2e3a4e;
    border-radius: 6px;
    padding: 10px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
}

/* Paperdoll Grid: Left Column | Character Space | Right Column */
.paperdoll-container {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    margin-top: 2px;
    margin-bottom: 12px;
}

.gear-column {
    flex-direction: column;
    justify-content: space-around;
    align-items: center;
}

/* Central Space Reserved for 3D Character Model / Sprite */
.character-preview-space {
    flex-grow: 1;
    height: 100%;
    min-height: 210px;
    margin-left: 6px;
    margin-right: 6px;
    background-color: rgba(255, 255, 255, 0.03);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
}

/* Bottom Relics Container inside Equipment Panel */
.relics-container {
    width: 100%;
    flex-direction: column;
    align-items: center;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
    padding-top: 10px;
    margin-top: auto;
}

.strip-title-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: #DAA520;
    margin-bottom: 6px;
    text-align: center;
}

/* Relics Row: Centered with Controlled Margins */
.slots-row {
    flex-direction: row;
    width: 100%;
    justify-content: center;
    align-items: center;
}

/* ==========================================
   CENTER PANEL: MAIN INVENTORY & GLOBAL BAG (45% Width)
   ========================================== */
.inventory-section {
    width: 45%;
    margin-right: 10px;
    background-color: rgba(15, 20, 28, 0.85);
    border-width: 2px;
    border-color: #2e3a4e;
    border-radius: 6px;
    padding: 10px;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
}

/* Inventory Header Box with Hero Icon Badge */
.inventory-header-box {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
}

.inventory-grid {
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
    justify-content: center;
    margin-top: 4px;
}

/* Global Key Items Section */
.global-bag-container {
    width: 100%;
    flex-direction: column;
    align-items: center;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
    padding-top: 10px;
    margin-top: 14px;
}

.global-bag-title-label {
    color: #3498DB; /* Cool Blue for Key / Global Items */
    margin-bottom: 6px;
}

.global-bag-grid {
    margin-top: 4px;
}

/* ==========================================
   RIGHT PANEL: ITEM INFORMATION & DETAILS (30% Width)
   ========================================== */
.item-info-panel {
    width: 30%;
    height: 100%;
    padding: 10px;
    background-color: rgba(15, 20, 28, 0.85);
    border-width: 2px;
    border-color: #2e3a4e;
    border-radius: 6px;
}

.item-preview-container {
    width: 100%;
    height: 100px;
    background-color: #0d131d;
    border-width: 1px;
    border-color: #253347;
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
}

/* Preview Icon Styling */
.item-preview-icon {
    width: 90px;
    height: 90px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 1px;
    border-color: rgba(218, 165, 32, 0.3);
    border-radius: 8px;
    flex-shrink: 0;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.item-name-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: #ffffff;
    text-align: center;
}

.item-type-label {
    font-size: 14px;
    color: #60A5FA;
    text-align: center;
    margin-bottom: 6px;
}

.item-meta-row {
    flex-direction: row;
    justify-content: space-between;
    background-color: #121a26;
    padding: 6px;
    border-radius: 4px;
    margin-bottom: 6px;
}

.item-meta-label {
    font-size: 12px;
    color: #aeb6bf;
}

.item-desc-label {
    font-size: 14px;
    color: #d5dbdb;
    white-space: normal;
    margin-bottom: 6px;
}

.extra-info-container {
     flex-grow: 1;

    flex-shrink: 1;
    height: 0;             /* CLAVE EN UNITY: Al poner height 0 con flex-grow 1, la caja SE ADAPTA al espacio sobrante pero NUNCA crece por su contenido */
    min-height: 0;
    overflow: hidden;

    background-color: #101722;
    border-width: 1px;
    border-color: #1f2d40;
    border-radius: 4px;
    padding: 4px;
}

/* ==========================================
   CUSTOM RPG STYLED SCROLLBAR FOR EXTRA INFO
   ========================================== */

/* Ancho general de la barra de scroll vertical */
.extra-info-container .unity-scroller--vertical {
    width: 8px;
    margin-left: 4px;
}

/* Oculta los botones de flecha arriba/abajo obsoletos */
.extra-info-container .unity-scroller__low-button,
.extra-info-container .unity-scroller__high-button {
    display: none;
    width: 0;
    height: 0;
}

/* Pista/Fondo por donde se desliza el cursor */
.extra-info-container .unity-base-slider__tracker {
    background-color: rgba(10, 15, 24, 0.8);
    border-width: 1px;
    border-color: rgba(31, 45, 64, 0.6);
    border-radius: 4px;
}

/* El cursor/tirador de la barra (Dragger) */
.extra-info-container .unity-base-slider__dragger {
    width: 6px;
    background-color: rgba(218, 165, 32, 0.5); /* Dorado suave de Golden Sun */
    border-width: 1px;
    border-color: rgba(255, 215, 0, 0.8);
    border-radius: 3px;
    transition-duration: 0.15s;
}

/* Efecto al pasar el ratón por encima del tirador */
.extra-info-container .unity-base-slider__dragger:hover {
    background-color: #FFD700;                  /* Dorado brillante */
    border-color: #FFFFFF;
}

/* Efecto al arrastrar activamente el tirador */
.extra-info-container .unity-base-slider__dragger:active {
    background-color: #FFA500;                  /* Tono ámbar/naranja */
}

/* ==========================================
   UNIFIED SQUARE SLOT STYLES (65px x 65px)
   ========================================== */
.slot-box {
    width: 65px;
    height: 65px;
    margin: 3px;
    background-color: rgba(20, 26, 38, 0.8);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    justify-content: center;
    align-items: center;
    position: relative;
}

/* Equipment Slot Specialization */
.gear-slot {
    border-color: rgba(218, 165, 32, 0.4);
}

/* Psynergy Relic Slot Specialization */
.relic-slot {
    border-color: rgba(155, 89, 182, 0.6);
    background-color: rgba(40, 24, 52, 0.8);
    margin: 0 4px;
}

.slot-placeholder {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-size: contain;
    background-position: center;
    opacity: 0.25;
}

.item-icon {
    width: 80%;
    height: 80%;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
}

.item-quantity-label {
    position: absolute;
    right: 4px;
    bottom: 2px;
    font-size: 13px;
    -unity-font-style: bold;
    color: #FFFFFF;
    -unity-text-outline-width: 1px;
    -unity-text-outline-color: #000000;
}

/* ==========================================
   STACK SPLITTER POPUP MODAL
   ========================================== */
.split-popup-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.75);
    justify-content: center;
    align-items: center;
    display: none;
}

.split-popup-dialog {
    width: 320px;
    max-width: 90%;
    background-color: #0c1018;
    border-width: 2px;
    border-color: #ffd700;
    border-radius: 6px;
    padding: 16px;
    align-items: center;
    overflow: hidden;
}

.split-item-preview-box {
    flex-direction: row;
    align-items: center;
    margin-top: 10px;
    margin-bottom: 12px;
}

.split-item-icon {
    width: 42px;
    height: 42px;
    margin-right: 10px;
    -unity-background-scale-mode: scale-to-fit;
}

.split-controls-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 10px;
    margin-bottom: 10px;
    overflow: hidden;
}

.split-step-btn {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    padding: 0;
    margin: 0;
    font-size: 18px;
    -unity-font-style: bold;
    flex-shrink: 0;
}

.split-slider {
    flex-grow: 1;
    flex-shrink: 1;
    width: 0;
    margin-left: 6px;
    margin-right: 6px;
    margin-top: 0;
    margin-bottom: 0;
    padding: 0;
}

.split-slider .unity-base-slider__input {
    margin: 0;
    padding: 0;
    min-width: 0;
}

.split-slider .unity-base-slider__drag-container {
    padding: 0;
    margin: 0;
}

.split-amount-label {
    width: 36px;
    min-width: 36px;
    font-size: 16px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #ffffff;
    flex-shrink: 0;
}

.split-buttons-row {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
    margin-top: 14px;
}

.split-action-btn {
    flex-grow: 1;
    height: 32px;
    margin-left: 4px;
    margin-right: 4px;
}