                                        <ui:VisualElement class="card-badges-row">
                                            <ui:Label text="Combate" class="psynergy-badge badge-battle" />
                                        </ui:VisualElement>
                                    </ui:VisualElement>
                                    <ui:VisualElement class="card-status-box">
