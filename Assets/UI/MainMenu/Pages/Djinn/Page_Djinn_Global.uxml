                                <ui:VisualElement class="stat-value-group">
                                    <ui:Label text="10" class="stat-val" />
                                    <ui:Label class="stat-delta" style="display: none;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="section-separator" />
                        <ui:VisualElement class="psynergy-view-container">
                            <ui:Label text="PSINERGÍAS AFECTADAS" class="subpanel-header-label" />
                            <ui:ScrollView class="psynergy-list-scroll modal-psy-scroll">
                                <ui:VisualElement class="mini-psy-card psy-card-lost">
                                    <ui:VisualElement class="card-element-stripe stripe-lost" />
                                    <ui:VisualElement class="card-icon-box">
