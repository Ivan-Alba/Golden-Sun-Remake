                                    <ui:Label text="Guerrero" class="summary-class-title class-title-next" />
                                </ui:VisualElement>
                                <ui:VisualElement class="summary-pips-row modal-pips-row">
                                    <ui:VisualElement class="pip-element-group">
                                        <ui:VisualElement class="pip-icon icon-venus" />
                                        <ui:Label text="1/1" class="pip-count" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="pip-element-group">
                                        <ui:VisualElement class="pip-icon icon-mars" />
                                        <ui:Label text="0/0" class="pip-count" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="pip-element-group">
                                        <ui:VisualElement class="pip-icon icon-jupiter" />
                                        <ui:Label text="0/0" class="pip-count" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="pip-element-group">
                                        <ui:VisualElement class="pip-icon icon-mercury" />
                                        <ui:Label text="0/0" class="pip-count" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="summary-stats-grid">
                            <ui:VisualElement class="summary-stat-item">
                                <ui:VisualElement class="stat-label-group">
                                    <ui:VisualElement class="stat-icon icon-attack" />
                                    <ui:Label text="ATQ" class="stat-name" />
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-value-group">
                                    <ui:Label text="130" class="stat-val" />
                                    <ui:Label text="(-8)" class="stat-delta delta-negative" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="summary-stat-item">
                                <ui:VisualElement class="stat-label-group">
                                    <ui:VisualElement class="stat-icon icon-defense" />
                                    <ui:Label text="DEF" class="stat-name" />
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-value-group">
                                    <ui:Label text="110" class="stat-val" />
                                    <ui:Label text="(+15)" class="stat-delta delta-positive" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="summary-stat-item">
                                <ui:VisualElement class="stat-label-group">
                                    <ui:VisualElement class="stat-icon icon-agility" />
                                    <ui:Label text="AGI" class="stat-name" />
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-value-group">
                                    <ui:Label text="55" class="stat-val" />
                                    <ui:Label class="stat-delta" style="display: none;" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                            <ui:VisualElement class="summary-stat-item">
                                <ui:VisualElement class="stat-label-group">
