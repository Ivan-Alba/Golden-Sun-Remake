<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="HeroSummaryHeader" src="project://database/Assets/UI/Components/HeroSummaryHeader.uxml" />
    <Style src="project://database/Assets/UI/MainMenu/Pages/Djinn/Page_Djinn.uss?fileID=7433441132597879392&amp;guid=7a1279321ab063d4db434976e80f0555&amp;type=3#Page_Djinn" />
    <Style src="project://database/Assets/UI/Global_Theme.uss?fileID=7433441132597879392&amp;guid=13e1da8cbe0216544974bb0aa6894e81&amp;type=3#Global_Theme" />
    <Style src="project://database/Assets/UI/Common_Layouts.uss?fileID=7433441132597879392&amp;guid=cf4db7a79be5e6c4489c6d3eabef35df&amp;type=3#Common_Layouts" />
    
    <ui:VisualElement name="page_djinn_global_container" class="page-djinn-container">
        <ui:VisualElement name="djinn_global_section" class="djinn-global-section">
            <ui:Label text="ORGANIZACIÓN GLOBAL DE DJINNS" class="info-title-label" />
            <ui:VisualElement name="party_columns_container" class="party-columns-container">
                
                <!-- Columna Héroe 1 -->
                <ui:VisualElement class="hero-djinn-column">
                    <ui:Instance template="HeroSummaryHeader" name="hero_summary_header_0" />
                    <ui:VisualElement name="column_slots_hero_0" class="column-slots-container" />
                </ui:VisualElement>
                
                <!-- Columna Héroe 2 -->
                <ui:VisualElement class="hero-djinn-column">
                    <ui:Instance template="HeroSummaryHeader" name="hero_summary_header_1" />
                    <ui:VisualElement name="column_slots_hero_1" class="column-slots-container" />
                </ui:VisualElement>
                
                <!-- Columna Héroe 3 -->
                <ui:VisualElement class="hero-djinn-column">
                    <ui:Instance template="HeroSummaryHeader" name="hero_summary_header_2" />
                    <ui:VisualElement name="column_slots_hero_2" class="column-slots-container" />
                </ui:VisualElement>
                
                <!-- Columna Héroe 4 -->
                <ui:VisualElement class="hero-djinn-column">
                    <ui:Instance template="HeroSummaryHeader" name="hero_summary_header_3" />
                    <ui:VisualElement name="column_slots_hero_3" class="column-slots-container" />
                </ui:VisualElement>

            </ui:VisualElement>
            
            <ui:VisualElement name="djinn_global_action_bar" class="djinn-action-bar">
                <ui:Button text="[ CANCEL / SELECT ] VOLVER A VISTA INDIVIDUAL" name="btn_switch_vista_a" class="action-switch-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
        
        <!-- Modal de Comparación -->
        <ui:VisualElement name="compare_modal_overlay" class="modal-overlay-container" style="display: none;">
            <ui:VisualElement class="compare-modal-box">
                <ui:Label text="CONFIRMAR INTERCAMBIO DE DJINNS" class="info-title-label compare-modal-title" />
                <ui:VisualElement class="compare-modal-content">
                    
                    <!-- Panel Héroe Izquierdo -->
                    <ui:VisualElement name="modal_hero_left" class="modal-hero-panel">
                        <ui:Instance template="HeroSummaryHeader" name="hero_summary_header_left" />
                        
                        <ui:VisualElement name="summary_stats_container" class="summary-stats-container">
                            <ui:Label text="ATRIBUTOS" class="subpanel-header-label" />
                            <ui:VisualElement name="stats_summary_grid" class="stats-grid">
                                <ui:VisualElement class="stat-item">
                                    <ui:VisualElement class="stat-label-group">
                                        <ui:VisualElement class="stat-icon icon-max-hp" />
                                        <ui:Label text="MAX HP" class="stat-name" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-value-group">
                                        <ui:Label text="230" name="label_stat_max_hp" class="stat-val" />
                                        <ui:Label text="+12" name="label_delta_max_hp" class="stat-delta delta-positive" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-item">
                                    <ui:VisualElement class="stat-label-group">
                                        <ui:VisualElement class="stat-icon icon-max-pp" />
                                        <ui:Label text="MAX PP" class="stat-name" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-value-group">
                                        <ui:Label text="230" name="label_stat_max_pp" class="stat-val" />
                                        <ui:Label text="+12" name="label_delta_max_pp" class="stat-delta delta-positive" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-item">
                                    <ui:VisualElement class="stat-label-group">
                                        <ui:VisualElement class="stat-icon icon-attack" />
                                        <ui:Label text="ATQ" class="stat-name" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-value-group">
                                        <ui:Label text="145" name="label_stat_atq" class="stat-val" />
                                        <ui:Label text="+12" name="label_delta_atq" class="stat-delta delta-positive" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-item">
                                    <ui:VisualElement class="stat-label-group">
                                        <ui:VisualElement class="stat-icon icon-defense" />
                                        <ui:Label text="DEF" class="stat-name" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-value-group">
                                        <ui:Label text="98" name="label_stat_def" class="stat-val" />
                                        <ui:Label text="-5" name="label_delta_def" class="stat-delta delta-negative" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-item">
                                    <ui:VisualElement class="stat-label-group">
                                        <ui:VisualElement class="stat-icon icon-agility" />
                                        <ui:Label text="AGI" class="stat-name" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-value-group">
                                        <ui:Label text="64" name="label_stat_agi" class="stat-val" />
                                        <ui:Label text="0" name="label_delta_agi" class="stat-delta" style="display: none;" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-item">
                                    <ui:VisualElement class="stat-label-group">
                                        <ui:VisualElement class="stat-icon icon-luck" />
                                        <ui:Label text="SUE" class="stat-name" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-value-group">
                                        <ui:Label text="12" name="label_stat_sue" class="stat-val" />
                                        <ui:Label text="0" name="label_delta_sue" class="stat-delta" style="display: none;" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="separator" class="info-divider" />
                        <ui:VisualElement name="psynergy_projection_container" class="summary-psynergy-view-container">
                            <ui:Label text="PSINERGÍAS RESULTANTES" class="subpanel-header-label" />
                            <ui:VisualElement name="psynergy_compare_tabs_left" class="summary-psynergy-filter-tabs" style="display: flex;">
                                <ui:Button text="TODAS" name="btn_filter_all_left" class="mini-tab-btn active" />
                                <ui:Button text="GANADAS" name="btn_filter_gained_left" class="mini-tab-btn tab-gained" />
                                <ui:Button text="PERDIDAS" name="btn_filter_lost_left" class="mini-tab-btn tab-lost" />
                            </ui:VisualElement>
                            <ui:ScrollView name="scroll_class_psynergies_left" class="summary-psynergy-list-scroll" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    
                    <!-- Acción Central -->
                    <ui:VisualElement class="compare-center-action-box">
                        <ui:Label text="INTERCAMBIO" class="compare-action-title" />
                        <ui:VisualElement class="compare-exchange-visual">
                            <ui:VisualElement class="compare-djinn-pill element-venus">
                                <ui:Label text="Granite" class="compare-djinn-pill-name" />
                            </ui:VisualElement>
                            <ui:Label text="⇄" class="compare-exchange-arrow" />
                            <ui:VisualElement class="compare-djinn-pill element-mars">
                                <ui:Label text="Forge" class="compare-djinn-pill-name" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="modal-actions-row">
                            <ui:Button text="[ A ] CONFIRMAR" name="btn_modal_confirm" class="modal-btn btn-confirm" />
                            <ui:Button text="[ B ] CANCELAR" name="btn_modal_cancel" class="modal-btn btn-cancel" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    
                    <!-- Panel Héroe Derecho -->
                    <ui:VisualElement name="modal_hero_right" class="modal-hero-panel">
                        <ui:Instance template="HeroSummaryHeader" name="hero_summary_header_right" />
                        
                        <ui:VisualElement name="summary_stats_container" class="summary-stats-container">
                            <ui:Label text="ATRIBUTOS" class="subpanel-header-label" />
                            <ui:VisualElement name="stats_summary_grid" class="stats-grid">
                                <ui:VisualElement class="stat-item">
                                    <ui:VisualElement class="stat-label-group">
                                        <ui:VisualElement class="stat-icon icon-max-hp" />
                                        <ui:Label text="MAX HP" class="stat-name" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-value-group">
                                        <ui:Label text="210" name="label_stat_max_hp" class="stat-val" />
                                        <ui:Label text="-10" name="label_delta_max_hp" class="stat-delta delta-negative" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-item">
                                    <ui:VisualElement class="stat-label-group">
                                        <ui:VisualElement class="stat-icon icon-max-pp" />
                                        <ui:Label text="MAX PP" class="stat-name" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-value-group">
                                        <ui:Label text="180" name="label_stat_max_pp" class="stat-val" />
                                        <ui:Label text="-5" name="label_delta_max_pp" class="stat-delta delta-negative" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-item">
                                    <ui:VisualElement class="stat-label-group">
                                        <ui:VisualElement class="stat-icon icon-attack" />
                                        <ui:Label text="ATQ" class="stat-name" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-value-group">
                                        <ui:Label text="130" name="label_stat_atq" class="stat-val" />
                                        <ui:Label text="-8" name="label_delta_atq" class="stat-delta delta-negative" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-item">
                                    <ui:VisualElement class="stat-label-group">
                                        <ui:VisualElement class="stat-icon icon-defense" />
                                        <ui:Label text="DEF" class="stat-name" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-value-group">
                                        <ui:Label text="110" name="label_stat_def" class="stat-val" />
                                        <ui:Label text="+15" name="label_delta_def" class="stat-delta delta-positive" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-item">
                                    <ui:VisualElement class="stat-label-group">
                                        <ui:VisualElement class="stat-icon icon-agility" />
                                        <ui:Label text="AGI" class="stat-name" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-value-group">
                                        <ui:Label text="55" name="label_stat_agi" class="stat-val" />
                                        <ui:Label text="0" name="label_delta_agi" class="stat-delta" style="display: none;" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                                <ui:VisualElement class="stat-item">
                                    <ui:VisualElement class="stat-label-group">
                                        <ui:VisualElement class="stat-icon icon-luck" />
                                        <ui:Label text="SUE" class="stat-name" />
                                    </ui:VisualElement>
                                    <ui:VisualElement class="stat-value-group">
                                        <ui:Label text="10" name="label_stat_sue" class="stat-val" />
                                        <ui:Label text="0" name="label_delta_sue" class="stat-delta" style="display: none;" />
                                    </ui:VisualElement>
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement name="separator" class="info-divider" />
                        <ui:VisualElement name="psynergy_projection_container" class="summary-psynergy-view-container">
                            <ui:Label text="PSINERGÍAS AFECTADAS" class="subpanel-header-label" />
                            <ui:VisualElement name="psynergy_compare_tabs_right" class="summary-psynergy-filter-tabs" style="display: flex;">
                                <ui:Button text="TODAS" name="btn_filter_all_right" class="mini-tab-btn active" />
                                <ui:Button text="GANADAS" name="btn_filter_gained_right" class="mini-tab-btn tab-gained" />
                                <ui:Button text="PERDIDAS" name="btn_filter_lost_right" class="mini-tab-btn tab-lost" />
                            </ui:VisualElement>
                            <ui:ScrollView name="scroll_class_psynergies_right" class="summary-psynergy-list-scroll" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>