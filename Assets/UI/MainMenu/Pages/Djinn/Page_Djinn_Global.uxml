                            <ui:Button text="[ B ] CANCELAR" name="btn_modal_cancel" class="modal-btn btn-cancel" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="modal_hero_right" class="djinn-summary-section modal-hero-panel">
                        <ui:VisualElement class="summary-box modal-integrated-hero-box">
                            <ui:VisualElement class="modal-hero-avatar-large">
                                <ui:VisualElement class="hero-avatar-icon" />
                            </ui:VisualElement>
                            <ui:VisualElement class="modal-hero-details-col">
                                <ui:VisualElement class="modal-hero-identity-row">
