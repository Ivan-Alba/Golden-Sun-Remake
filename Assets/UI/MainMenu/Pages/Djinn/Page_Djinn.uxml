<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="HeroSummaryHeader" src="project://database/Assets/UI/Components/HeroSummaryHeader.uxml?fileID=9197481963319205126&amp;guid=dd9c1beaf6716f1448ed73c9e8292334&amp;type=3#HeroSummaryHeader" />
    <ui:Template name="CharacterStatsGrid" src="project://database/Assets/UI/Components/CharacterStatsGrid.uxml?fileID=9197481963319205126&amp;guid=3af735e5c0a48f642822636f051f6c3c&amp;type=3#CharacterStatsGrid" />
    <ui:Template name="ElementalAffinityGrid" src="project://database/Assets/UI/Components/ElementalAffinityGrid.uxml?fileID=9197481963319205126&amp;guid=68abfa5848718a444971ab998d35f6d9&amp;type=3#ElementalAffinityGrid" />
    <Style src="project://database/Assets/UI/MainMenu/Pages/Djinn/Page_Djinn.uss?fileID=7433441132597879392&amp;guid=7a1279321ab063d4db434976e80f0555&amp;type=3#Page_Djinn" />
    <Style src="project://database/Assets/UI/Global_Theme.uss?fileID=7433441132597879392&amp;guid=13e1da8cbe0216544974bb0aa6894e81&amp;type=3#Global_Theme" />
    <Style src="project://database/Assets/UI/Common_Layouts.uss?fileID=7433441132597879392&amp;guid=cf4db7a79be5e6c4489c6d3eabef35df&amp;type=3#Common_Layouts" />
    <ui:VisualElement name="page_djinn_container" class="page-three-columns-container">
        <ui:VisualElement name="djinn_summary_section" class="panel-column-left djinn-summary-panel">
            <ui:Label text="ESTADO DE CLASE" name="label_summary_header" class="info-title-label" />
            <ui:Instance template="HeroSummaryHeader" name="hero_summary_header" class="hero-header-instance" />
            <ui:VisualElement name="summary_stats_container" class="summary-stats-container">
                <ui:Label text="ATRIBUTOS" class="section-header-title" />
                <ui:Instance template="CharacterStatsGrid" name="character_stats_grid" class="character-stats-instance" />
                <ui:Label text="AFINIDAD ELEMENTAL" class="section-header-title" />
                <ui:Instance template="ElementalAffinityGrid" name="elemental_affinity_grid" class="elemental-affinity-instance" />
            </ui:VisualElement>
            <ui:VisualElement name="separator" class="info-divider" />
            <ui:VisualElement name="psynergy_projection_container" class="summary-psynergy-view-container">
                <ui:Label text="PSINERGÍAS DE CLASE" class="subpanel-header-label" />
                <ui:VisualElement name="psynergy_compare_tabs" class="summary-psynergy-filter-tabs" style="display: none;">
                    <ui:Button text="TODAS" name="btn_filter_all" class="mini-tab-btn active" />
                    <ui:Button text="GANADAS" name="btn_filter_gained" class="mini-tab-btn tab-gained" />
                    <ui:Button text="PERDIDAS" name="btn_filter_lost" class="mini-tab-btn tab-lost" />
                </ui:VisualElement>
                <ui:ScrollView name="scroll_class_psynergies" class="summary-psynergy-list-scroll" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="djinn_list_section" class="panel-column-center djinn-central-panel">
            <ui:Label text="SANTUARIO ELEMENTAL" name="label_djinn_title" class="info-title-label" />
            <ui:VisualElement name="djinn_viewport_container" class="djinn-viewport-container">
                <ui:VisualElement name="djinn_3d_render_target" class="djinn-render-target" />
            </ui:VisualElement>
            <ui:VisualElement name="djinn_grid_section" class="djinn-grid-section">
                <ui:Label text="DJINNS EQUIPADOS (0/8)" name="label_grid_header" class="subpanel-header-label" />
                <ui:VisualElement name="djinn_slots_grid" class="djinn-slots-grid" />
            </ui:VisualElement>
            <ui:VisualElement name="djinn_action_bar" class="djinn-action-bar">
                <ui:Button text="[ SELECT ] ORGANIZACIÓN GLOBAL DE PARTY" name="btn_switch_vista_b" class="action-switch-btn" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="djinn_info_panel" class="panel-column-right">
            <ui:Label text="INFORMACIÓN DJINN" name="label_info_title" class="info-title-label" />
            <ui:VisualElement name="djinn_preview_container" class="detail-preview-container-wide">
                <ui:VisualElement name="djinn_video_preview" class="detail-preview-render" />
            </ui:VisualElement>
            <ui:VisualElement name="detail_icon_name_row" class="detail-icon-name-row">
                <ui:VisualElement name="detail_djinn_icon" class="pip-icon icon-venus" />
                <ui:Label text="Flint" name="label_djinn_name" class="detail-name-label" />
            </ui:VisualElement>
            <ui:Label text="Djinn de Tierra - Venus" name="label_djinn_type" class="detail-type-label" />
            <ui:VisualElement name="djinn_meta_row" class="detail-meta-row">
                <ui:Label text="Estado: PREPARADO" name="label_djinn_status" class="detail-meta-label text-muted" />
                <ui:Label text="Recuperación: 2 Turnos" name="label_djinn_recovery" class="djinn-meta-label detail-meta-label text-muted" />
            </ui:VisualElement>
            <ui:VisualElement name="djinn_desc_container" class="detail-desc-container">
                <ui:Label text="Desencadena un ataque terrestre impregnado de la fuerza telúrica de Venus." name="label_djinn_desc" class="detail-desc-label" />
            </ui:VisualElement>
            <ui:ScrollView name="djinn_extra_details_box" class="extra-info-container">
                <ui:VisualElement name="extra_info_card_root" class="extra-info-card-root">
                    <ui:Label text="BONOS DE ATRIBUTO" class="section-header-title" />
                    <ui:Instance template="CharacterStatsGrid" name="character_stats_grid" class="character-stats-instance" />
                    <ui:Label text="BONO ELEMENTAL" class="section-header-title" />
                    <ui:Instance template="ElementalAffinityGrid" name="elemental_affinity_grid" class="elemental-affinity-instance" />
                    <ui:VisualElement class="info-divider" />
                    <ui:Label text="EFECTO DE LIBERACIÓN" class="section-header-title" />
                    <ui:Label text="Golpe Demoledor" name="label_unleash_name" class="unleash-name-label" />
                    <ui:Label text="Ataca al enemigo con un potente golpe telúrico que puede causar aturdimiento." name="label_unleash_desc" class="unleash-desc-label" />
                    <ui:VisualElement name="box_unleash_status_effect_info" class="unleash-status-effect-row" />
                    <ui:VisualElement class="info-divider" />
                    <ui:Label text="PASIVA DE LÍDER" class="section-header-title" />
                    <ui:Label text="Romperocas" name="label_leader_passive_title" class="unleash-name-label" />
                    <ui:Label text="Aumenta el daño crítico físico un 15% mientras esté en estado Preparado." name="label_leader_passive_desc" class="unleash-desc-label" />
                </ui:VisualElement>
            </ui:ScrollView>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
