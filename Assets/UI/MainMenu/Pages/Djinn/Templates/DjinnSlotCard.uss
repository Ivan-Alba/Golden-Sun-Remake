/* ==========================================================================
   DJINN SLOT CARD TEMPLATE STYLES
   ========================================================================== */

.djinn-slot-card Label {
    margin: 0;
    padding: 0;
}

/* 1. Wrapper posicional (TemplateContainer) */
.djinn-slot-card {
    width: 24%;
    height: 48%;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
}

/* 2. Tarjeta real (Interior del UXML) */
#djinn_slot_card_root {
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    background-color: #0d131d;
    border-width: 1px;
    border-color: #253347;
    border-radius: 5px;
    padding: 4px;
    position: relative;
    overflow: hidden;
}

#djinn_slot_card_root:hover {
    border-color: #d4af37;
    background-color: #141d2c;
}

/* Estado Seleccionado / Destacado */
#djinn_slot_card_root.djinn-card-selected {
    border-color: #FFD700 !important;
    border-width: 2px !important;
    background-color: rgba(212, 175, 55, 0.12) !important;
}

.djinn-principal-star {
    position: absolute;
    top: 2px;
    right: 4px;
    font-size: 9px;
    color: #FFD700;
}

/* Caja del Retrato / Icono */
.djinn-card-portrait-box {
    width: 50px;
    height: 50px;
    background-color: rgba(0, 0, 0, 0.3);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    justify-content: center;
    align-items: center;
    margin-right: 6px;
    flex-shrink: 0;
}

.djinn-card-icon {
    width: 100%;
    height: 100%;
    -unity-background-scale-mode: scale-to-fit;
}

/* Columna de Información a la derecha del retrato */
.djinn-card-info-col {
    flex-grow: 1;
    height: 38px; /* Muestra la misma altura útil que el retrato */
    justify-content: space-between;
    align-items: flex-start;
    overflow: hidden;
}

/* Fila del Título (Pip + Nombre alineados a la izquierda) */
.djinn-card-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start; /* Forzar pegado a la izquierda */
    width: 100%;
    overflow: hidden;
}

/* Pip elemental */
.element-pip-icon {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 4px;
    border-width: 1px;
    flex-shrink: 0;
}

.icon-venus { background-color: #C88A2E; border-color: rgba(255, 255, 255, 0.4); }
.icon-mars { background-color: #E74C3C; border-color: rgba(255, 255, 255, 0.4); }
.icon-jupiter { background-color: #9B59B6; border-color: rgba(255, 255, 255, 0.4); }
.icon-mercury { background-color: #3498DB; border-color: rgba(255, 255, 255, 0.4); }
.icon-none { background-color: #555555; border-color: rgba(255, 255, 255, 0.4); }

/* Nombre pegado a la izquierda junto al pip */
.djinn-card-name {
    font-size: 10.5px;
    -unity-font-style: bold;
    color: #ffffff;
    -unity-text-align: middle-left;
    -unity-text-overflow-position: end;
    flex-shrink: 1;
}

/* Botón de Estado ajustado al ancho de la columna */
.djinn-status-btn {
    height: 16px;
    font-size: 7.5px;
    -unity-font-style: bold;
    border-radius: 2px;
    padding: 0;
    border-width: 1px;
    margin: 0;
    width: 100%;
}

.status-set {
    background-color: rgba(0, 255, 136, 0.15);
    border-color: rgba(0, 255, 136, 0.4);
    color: #00FF88;
}

.status-standby {
    background-color: rgba(241, 196, 15, 0.15);
    border-color: rgba(241, 196, 15, 0.4);
    color: #F1C40F;
}

.status-recovery {
    background-color: rgba(231, 76, 60, 0.15);
    border-color: rgba(231, 76, 60, 0.4);
    color: #E74C3C;
}

/* Estado Vacío */
#djinn_slot_card_root.djinn-card-empty {
    border-style: dashed;
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(10, 15, 22, 0.3);
    align-items: center;
    justify-content: center;
}

.djinn-empty-label {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.25);
    -unity-text-align: middle-center;
    width: 100%;
}

/* Bordes por Elemento */
#djinn_slot_card_root.djinn-card-venus { border-color: rgba(212, 172, 13, 0.6); }
#djinn_slot_card_root.djinn-card-mars { border-color: rgba(231, 76, 60, 0.6); }
#djinn_slot_card_root.djinn-card-jupiter { border-color: rgba(175, 122, 197, 0.6); }
#djinn_slot_card_root.djinn-card-mercury { border-color: rgba(52, 152, 219, 0.6); }