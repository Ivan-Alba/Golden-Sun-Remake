/* ==========================================================================
   GLOBAL ENRICHED DJINN CARD (VISTA B)
   ========================================================================== */

.djinn-card-b-root {
    width: 100%;
    height: 68px;
    max-height: 68px;
    background-color: rgba(10, 16, 26, 0.75);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    padding: 3px 5px;
    margin-bottom: 2px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    overflow: hidden; /* Garantiza que nada desborde la tarjeta */
}

.djinn-card-b-root Label {
    margin: 0;
    padding: 0;
}

/* 2. CONTENEDOR INTERNO DE CONTENIDO */
.djinn-card-b-body {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* 3. BLOQUE IZQUIERDO: RETRATO */
.djinn-card-portrait-box {
    width: 50px;
    height: 50px;
    min-width: 50px;
    min-height: 50px;
    background-color: rgba(0, 0, 0, 0.5);

    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.djinn-card-icon {
    width: 95%;
    height: 95%;
    -unity-background-scale-mode: scale-to-fit;
}

/* 4. BLOQUE DERECHO: CONTENEDOR PRINCIPAL */
.djinn-card-main-info {
    flex-grow: 1;
    height: 100%;
    justify-content: space-between;
    margin-left: 6px;
    overflow: hidden;
}

/* 5. FILA 1: PIP + NOMBRE | CHIP LÍDER */
.djinn-card-title-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 2px;
    height: auto;
}

.djinn-card-name-group {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
    overflow: hidden;
}

.element-pip-icon {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    margin-right: 4px;
    flex-shrink: 0;
}

.djinn-card-name {
    font-size: 11px;
    -unity-font-style: bold;
    color: #FFFFFF;
    margin: 0;
    padding: 0;
    -unity-text-overflow-position: end;
}

.djinn-card-leader-group {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.btn-leader-tag {
    font-size: 8px;
    -unity-font-style: bold;
    border-radius: 2px;
    padding: 1px 4px;
    margin: 0;
    border-width: 1px;
}

.leader-active {
    color: #FFD700;
    background-color: rgba(255, 215, 0, 0.2);
    border-color: rgba(255, 215, 0, 0.5);
}

.leader-inactive {
    color: #8C9BA5;
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
}

/* 6. FILA 2: CONTENEDOR INFERIOR DUAL */
.djinn-card-bottom-row {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    width: 100%;
    flex-grow: 1;
    margin-top: 2px;
}

.djinn-card-unleash-col {
    flex-direction: row;
    flex-wrap: wrap;
    width: 65%;
    height: 100%;
    max-height: 100%;
    align-items: center;
    flex-grow: 0;
    flex-shrink: 0;
    overflow: hidden;
}

.djinn-unleash-val {
    font-size: 8px;
    color: #FFFFFF;
    -unity-font-style: bold;
    white-space: normal;
    margin: 0;
    padding: 0;
    flex-grow: 1;
    flex-shrink: 1;
}

/* COLUMNA DERECHA: BOTÓN DERECHO INFERIOR */
.djinn-card-status-col {
    justify-content: flex-end;
    align-items: flex-end;
    flex-shrink: 0;
    flex-grow: 1;
}

.btn-compact {
    width: 90%;
    height: 14px;
    font-size: 8px;
    -unity-font-style: bold;
    padding: 8px 6px;
    margin: 0;
    flex-shrink: 0;
    border-radius: 2px;
}

.status-set {
    background-color: rgba(46, 204, 113, 0.2);
    border-color: rgba(46, 204, 113, 0.5);
    color: #2ECC71;
}

.status-standby {
    background-color: rgba(241, 196, 15, 0.2);
    border-color: rgba(241, 196, 15, 0.5);
    color: #F1C40F;
}

.status-recovery {
    background-color: rgba(231, 76, 60, 0.2);
    border-color: rgba(231, 76, 60, 0.5);
    color: #E74C3C;
}

/* ESTADO VACÍO */
.djinn-empty-label {
    width: 100%;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.3);
    -unity-text-align: middle-center;
}

