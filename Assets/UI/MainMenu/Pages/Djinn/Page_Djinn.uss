/* ==========================================================================
   PAGE DJINN MAIN LAYOUT (Inherits Summary Panel & Chassis from Common_Layouts.uss)
   ========================================================================== */

.djinn-summary-panel {
    align-items: stretch;
}

.subpanel-header-label {
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: upper-left;
    color: var(--color-gold-sun);
    margin-bottom: 6px;
    margin-top: 5px;
    letter-spacing: 0.5px;
    flex-shrink: 0;
}

.section-separator {
    height: 1px;
    width: 100%;
    background-color: #2e3a4e;
    margin-top: 5px;
    margin-bottom: 5px;
    flex-shrink: 0;
    flex-grow: 0;
}

/* ==========================================================================
   CENTER PANEL: SANCTUARY 3D VIEWPORT & DJINN GRID SPECIFICS
   ========================================================================== */
.djinn-viewport-container {
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: 0;
    width: 100%;
    background-color: #05080c;
    border-width: 1px;
    border-color: rgba(46, 75, 110, 0.6);
    border-radius: 6px;
    overflow: hidden;
    margin-bottom: 8px; 
}

.djinn-render-target {
    width: 100%;
    height: 100%;
    background-color: rgba(8, 14, 22, 0.85);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.5);
    border-radius: 5px;
}

.djinn-grid-section {
    width: 100%;
    height: 170px;
    flex-shrink: 0;
    flex-grow: 0;
    flex-direction: column;
    margin-bottom: 4px;
}

.djinn-slots-grid {
    flex-grow: 1;
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-content: space-between;
}

.djinn-slot-card {
    width: 24.2%;
    height: 48%;
    flex-shrink: 0;
    padding: 0;
    margin: 2px;
}

.djinn-action-bar {
    width: 100%;
    height: 28px;
    margin-top: 6px;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.action-switch-btn {
    font-size: 12px;
    height: 100%;
    width: 100%;
    background-color: #1a2538;
    border-width: 1px;
    border-color: #2e3a4e;
    border-radius: 4px;
    color: var(--color-gold-sun);
    -unity-font-style: bold;
}

.action-switch-btn:hover {
    background-color: #2b3d59;
    border-color: #d4af37;
    color: var(--color-text-white);
}

/* ==========================================================================
   RIGHT PANEL SPECIFICS & EXTRA INFO DETAILS
   ========================================================================== */
.djinn-meta-label {
    font-size: 11px;
    color: #aeb6bf;
}

.detail-section-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--color-gold-sun);
    margin-bottom: 3px;
}

.detail-separator {
    height: 1px;
    background-color: #1f2d40;
    margin-top: 6px;
    margin-bottom: 6px;
}

.unleash-name-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--color-accent-blue);
    margin-bottom: 2px;
}

.unleash-desc-label {
    font-size: 9.5px;
    color: #d5dbdb;
    white-space: normal;
    margin-bottom: 4px;
}

.detail-unleash-row {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    margin-bottom: 2px;
}

.unleash-badge {
    flex-direction: row;
    align-items: center;
    font-size: 9px;
    -unity-font-style: bold;
    padding: 2px 6px;
    border-radius: 3px;
    margin-right: 4px;
    margin-bottom: 3px;
    border-width: 1px;
}

.badge-target {
    color: #A0B0C0;
    background-color: rgba(160, 176, 192, 0.15);
    border-color: rgba(160, 176, 192, 0.3);
}

.badge-damage {
    color: #5DADE2;
    background-color: rgba(93, 173, 226, 0.15);
    border-color: rgba(93, 173, 226, 0.35);
}

.badge-buff {
    color: #2ECC71;
    background-color: rgba(46, 204, 113, 0.15);
    border-color: rgba(46, 204, 113, 0.35);
}

.badge-debuff {
    color: #E67E22;
    background-color: rgba(230, 126, 34, 0.15);
    border-color: rgba(230, 126, 34, 0.35);
}

.badge-ailment {
    color: #A569BD;
    background-color: rgba(165, 105, 189, 0.18);
    border-color: rgba(165, 105, 189, 0.4);
}

.passive-name-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--color-accent-blue);
    margin-bottom: 2px;
}

.passive-desc-label {
    font-size: 9.5px;
}

/* ==========================================================================
   GLOBAL PARTY ORGANIZER & MODAL OVERLAY (VISTA B)
   ========================================================================== */
.djinn-global-section {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: 8px;
    background-color: rgba(15, 20, 28, 0.85);
    border-width: 2px;
    border-color: #2e3a4e;
    border-radius: 6px;
    flex-direction: column;
    overflow: hidden;
}

.party-columns-container {
    flex-grow: 1;
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    margin-bottom: 6px;
}

.hero-djinn-column {
    width: 23%;
    max-width: 24%;
    margin: 0 6px;
    background-color: rgba(10, 15, 22, 0.6);
    border-width: 1px;
    border-color: #1f2d40;
    border-radius: 5px;
    padding: 5px;
    flex-direction: column;
}

.hero-column-name {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
}

.modal-overlay-container {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: rgba(5, 8, 12, 0.88);
    justify-content: center;
    align-items: center;
    padding: 12px;
}

.compare-modal-box {
    width: 920px;
    height: 540px;
    background-color: #0b1017;
    border-width: 2px;
    border-color: var(--color-gold-sun);
    border-radius: 8px;
    padding: 12px;
    flex-direction: column;
}