                    <ui:Instance template="ElementalAffinityGrid" name="elemental_affinity_grid_2" />
                </ui:VisualElement>
                
                <ui:VisualElement name="main_djinn_card_2" picking-mode="Ignore" class="main-djinn-card">
                    <ui:VisualElement name="djinn_header_row_2" class="djinn-header-row">
                        <ui:Label text="DJINN PRINCIPAL" class="section-header-label djinn-header-label section-header-title" />
                        <ui:VisualElement name="badge_status_2" class="djinn-status-badge djinn-badge-active">
                            <ui:Label text="PASIVA ACTIVA" name="label_badge_status_2" class="djinn-status-badge-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="main_djinn_body_2" class="main-djinn-body element-jupiter element-jupiter-bg">
                        <ui:VisualElement name="main_djinn_icon_2" picking-mode="Ignore" class="main-djinn-full-icon" />
                        <ui:VisualElement name="main_djinn_details_2" picking-mode="Ignore" class="main-djinn-details">
                            <ui:VisualElement name="main_djinn_name_row_2" class="main-djinn-name-row">
                                <ui:VisualElement name="main_djinn_element_icon_2" class="pip-icon icon-jupiter" />
                                <ui:Label text="Gust" name="label_main_djinn_name_2" picking-mode="Ignore" enable-rich-text="true" class="main-djinn-name-label" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="info-divider" />
                            <ui:Label text="PASIVA: Agilidad Celeste" name="label_passive_title_2" picking-mode="Ignore" class="passive-title-label" />
                            <ui:Label text="Aumenta 20% agilidad y regeneración de PP." name="label_passive_desc_2" picking-mode="Ignore" class="passive-desc-label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- HÉROE 3 (Mia) -->
