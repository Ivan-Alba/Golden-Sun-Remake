                    </ui:VisualElement>
                    <ui:VisualElement name="pp_bar_box_2" picking-mode="Ignore" class="stat-bar-box">
                        <ui:Label text="PP 120/120" name="label_pp_text_2" picking-mode="Ignore" class="bar-label-text" />
