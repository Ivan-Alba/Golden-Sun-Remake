<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="HeroSummaryHeader" src="project://database/Assets/UI/Components/HeroSummaryHeader.uxml?fileID=9197481963319205126&amp;guid=dd9c1beaf6716f1448ed73c9e8292334&amp;type=3#HeroSummaryHeader" />
    <ui:Template name="CharacterStatsGrid" src="project://database/Assets/UI/Components/CharacterStatsGrid.uxml?fileID=9197481963319205126&amp;guid=3af735e5c0a48f642822636f051f6c3c&amp;type=3#CharacterStatsGrid" />
    <ui:Template name="ElementalAffinityGrid" src="project://database/Assets/UI/Components/ElementalAffinityGrid.uxml" />
    
    <Style src="project://database/Assets/UI/MainMenu/Pages/Status/Page_Status.uss?fileID=7433441132597879392&amp;guid=ab5dc87744cf3554aae967c803f3895f&amp;type=3#Page_Status" />
    <Style src="project://database/Assets/UI/Common_Layouts.uss?fileID=7433441132597879392&amp;guid=cf4db7a79be5e6c4489c6d3eabef35df&amp;type=3#Common_Layouts" />
    <Style src="project://database/Assets/UI/Global_Theme.uss?fileID=7433441132597879392&amp;guid=13e1da8cbe0216544974bb0aa6894e81&amp;type=3#Global_Theme" />
    
    <ui:VisualElement name="page_status_container" picking-mode="Ignore" class="page-status-container" style="flex-direction: row; justify-content: center; flex-grow: 1; height: 100%;">
        
        <!-- HÉROE 0 (Hans) -->
        <ui:VisualElement name="hero_card_0" class="hero-card" style="display: flex;">
            <ui:VisualElement name="card_front_0" picking-mode="Ignore" class="card-face card-front" style="display: flex;">
                <ui:Instance template="HeroSummaryHeader" name="hero_summary_header_0" class="hero-header-instance" />
                
                <ui:VisualElement name="bars_container_0" picking-mode="Ignore" class="bars-container">
                    <ui:VisualElement name="hp_bar_box_0" picking-mode="Ignore" class="stat-bar-box">
                        <ui:Label text="PV 240/240" name="label_hp_text_0" picking-mode="Ignore" class="bar-label-text" />
                        <ui:ProgressBar value="100" name="bar_hp_0" picking-mode="Ignore" class="custom-bar hp-bar" />
                    </ui:VisualElement>
                    <ui:VisualElement name="pp_bar_box_0" picking-mode="Ignore" class="stat-bar-box">
                        <ui:Label text="PP 80/80" name="label_pp_text_0" picking-mode="Ignore" class="bar-label-text" />
                        <ui:ProgressBar value="100" name="bar_pp_0" picking-mode="Ignore" class="custom-bar pp-bar" />
                    </ui:VisualElement>
                </ui:VisualElement>
                
                <ui:VisualElement name="stats_section_0" picking-mode="Ignore" class="section-box">
                    <ui:Label text="ATRIBUTOS" class="section-header-title" />
                    <ui:Instance template="CharacterStatsGrid" name="character_stats_grid_0" class="character-stats-instance" />
                </ui:VisualElement>
                
                <ui:VisualElement name="element_section_0" picking-mode="Ignore" class="section-box">
                    <ui:Label text="AFINIDAD ELEMENTAL" class="section-header-title" />
                    <ui:Instance template="ElementalAffinityGrid" name="elemental_affinity_grid_0" />
                </ui:VisualElement>
                
                <ui:VisualElement name="main_djinn_card_0" picking-mode="Ignore" class="main-djinn-card">
                    <ui:VisualElement name="djinn_header_row_0" class="djinn-header-row">
                        <ui:Label text="DJINN PRINCIPAL" class="section-header-title" />
                        <ui:VisualElement name="badge_status_0" class="djinn-status-badge djinn-badge-active">
                            <ui:Label text="PASIVA ACTIVA" name="label_badge_status_0" class="djinn-status-badge-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="main_djinn_body_0" class="main-djinn-body element-venus element-venus-bg">
                        <ui:VisualElement name="main_djinn_icon_0" picking-mode="Ignore" class="main-djinn-full-icon" />
                        <ui:VisualElement name="main_djinn_details_0" picking-mode="Ignore" class="main-djinn-details">
                            <ui:VisualElement name="main_djinn_name_row_0" class="main-djinn-name-row">
                                <ui:VisualElement name="main_djinn_element_icon_0" class="pip-icon icon-venus" />
                                <ui:Label text="Flint" name="label_main_djinn_name_0" picking-mode="Ignore" class="main-djinn-name-label" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="info-divider" />
                            <ui:Label text="PASIVA: Resonancia Terrestre" name="label_passive_title_0" picking-mode="Ignore" class="passive-title-label" />
                            <ui:Label text="Aumenta 15% daño de Venus y defensa física." name="label_passive_desc_0" picking-mode="Ignore" class="passive-desc-label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- HÉROE 1 (Garet) -->
        <ui:VisualElement name="hero_card_1" class="hero-card" style="display: flex;">
            <ui:VisualElement name="card_front_1" picking-mode="Ignore" class="card-face card-front" style="display: flex;">
                <ui:Instance template="HeroSummaryHeader" name="hero_summary_header_1" class="hero-header-instance" />
                
                <ui:VisualElement name="bars_container_1" picking-mode="Ignore" class="bars-container">
                    <ui:VisualElement name="hp_bar_box_1" picking-mode="Ignore" class="stat-bar-box">
                        <ui:Label text="PV 260/260" name="label_hp_text_1" picking-mode="Ignore" class="bar-label-text" />
                        <ui:ProgressBar value="100" name="bar_hp_1" picking-mode="Ignore" class="custom-bar hp-bar" />
                    </ui:VisualElement>
                    <ui:VisualElement name="pp_bar_box_1" picking-mode="Ignore" class="stat-bar-box">
                        <ui:Label text="PP 60/60" name="label_pp_text_1" picking-mode="Ignore" class="bar-label-text" />
                        <ui:ProgressBar value="100" name="bar_pp_1" picking-mode="Ignore" class="custom-bar pp-bar" />
                    </ui:VisualElement>
                </ui:VisualElement>
                
                <ui:VisualElement name="stats_section_1" picking-mode="Ignore" class="section-box">
                    <ui:Label text="ATRIBUTOS" class="section-header-title" />
                    <ui:Instance template="CharacterStatsGrid" name="character_stats_grid_1" class="character-stats-instance" />
                </ui:VisualElement>
                
                <ui:VisualElement name="element_section_1" picking-mode="Ignore" class="section-box">
                    <ui:Label text="AFINIDAD ELEMENTAL" class="section-header-label section-header-title" />
                    <ui:Instance template="ElementalAffinityGrid" name="elemental_affinity_grid_1" />
                </ui:VisualElement>
                
                <ui:VisualElement name="main_djinn_card_1" picking-mode="Ignore" class="main-djinn-card">
                    <ui:VisualElement name="djinn_header_row_1" class="djinn-header-row">
                        <ui:Label text="DJINN PRINCIPAL" class="section-header-label djinn-header-label section-header-title" />
                        <ui:VisualElement name="badge_status_1" class="djinn-status-badge djinn-badge-active">
                            <ui:Label text="PASIVA ACTIVA" name="label_badge_status_1" class="djinn-status-badge-text" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="main_djinn_body_1" class="main-djinn-body element-mars element-mars-bg">
                        <ui:VisualElement name="main_djinn_icon_1" picking-mode="Ignore" class="main-djinn-full-icon" />
                        <ui:VisualElement name="main_djinn_details_1" picking-mode="Ignore" class="main-djinn-details">
                            <ui:VisualElement name="main_djinn_name_row_1" class="main-djinn-name-row">
                                <ui:VisualElement name="main_djinn_element_icon_1" class="pip-icon icon-mars" />
                                <ui:Label text="Forge" name="label_main_djinn_name_1" picking-mode="Ignore" class="main-djinn-name-label" />
                            </ui:VisualElement>
                            <ui:VisualElement picking-mode="Ignore" class="info-divider" />
                            <ui:Label text="PASIVA: Furia Ígnea" name="label_passive_title_1" picking-mode="Ignore" class="passive-title-label" />
                            <ui:Label text="Incrementa el crítico físico un 10% y poder Marte." name="label_passive_desc_1" picking-mode="Ignore" class="passive-desc-label" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- HÉROE 2 (Ivan) -->
        <ui:VisualElement name="hero_card_2" class="hero-card" style="display: flex;">
            <ui:VisualElement name="card_front_2" picking-mode="Ignore" class="card-face card-front" style="display: flex;">
                <ui:Instance template="HeroSummaryHeader" name="hero_summary_header_2" class="hero-header-instance" />
                
