.page-status-container {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    flex-grow: 1;
    height: 100%;
    padding: 10px;
    color: rgb(255, 255, 255);
}

.hero-card {
    width: 23.5%;
    margin: 0 6px;
    background-color: rgba(15, 20, 28, 0.85);
    border-width: 2px;
    border-color: rgb(46, 58, 78);
    border-radius: 6px;
    padding: 10px;
    position: relative;
    overflow: hidden;
    color: rgb(255, 255, 255);
    height: auto;
}

.card-face {
    position: relative;
    width: 100%;
    height: auto;
    padding: 0;
    display: flex;
    flex-direction: column;
}

.page-status-container Label {
    margin: 0;
    padding: 0;
}

.card-front {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    height: auto;
}

.page-status-container .summary-hero-box {
    padding: 10px 12px;
}

.page-status-container .summary-hero-avatar-box {
    width: 100px;
    height: 100px;
}

.page-status-container .summary-hero-name {
    font-size: 18px;
}

.page-status-container .summary-class-title {
    font-size: 14px;
}

.page-status-container .pip-count {
    font-size: 13px;
}

.bars-container {
    width: 100%;
    flex-direction: column;
    margin-bottom: 6px;
}

.stat-bar-box {
    width: 100%;
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.page-status-container .bar-label-text {
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: center;
    -unity-text-align: upper-center;
    color: rgb(224, 224, 224);
    margin-bottom: 1px;
    width: 100%;
    display: flex;
}

.custom-bar {
    height: 12px;
    border-radius: 3px;
    margin: 0;
    padding: 0;
    width: 100%;
}

.custom-bar .unity-progress-bar__container {
    height: 100%;
    min-height: 14px;
    max-height: 14px;
}

.custom-bar .unity-progress-bar__background {
    background-color: rgba(10, 10, 15, 0.8);
    border-radius: 3px;
    border-width: 0;
    height: 100%;
}

.hp-bar .unity-progress-bar__progress {
    background-color: rgb(46, 204, 113);
    border-radius: 3px;
}

.pp-bar .unity-progress-bar__progress {
    background-color: rgb(52, 152, 219);
    border-radius: 3px;
}

.section-box {
    width: 100%;
    background-color: rgba(15, 15, 20, 0.6);
    border-radius: 5px;
    padding: 6px 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    margin-bottom: 6px;
}

.main-djinn-card {
    width: 100%;
    flex-direction: column;
    background-color: rgba(15, 15, 20, 0.6);
    border-radius: 5px;
    padding: 6px 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    transition-property: opacity;
    transition-duration: 0.2s;
}

.djinn-card-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.08);
    margin-bottom: 5px;
}

.djinn-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.page-status-container .djinn-header-label {
    margin-bottom: 0;
}

.page-status-container .djinn-status-badge {
    padding: 1px 6px;
    border-radius: 3px;
    border-width: 1px;
}

.djinn-status-badge-text {
    font-size: 9px;
    -unity-font-style: bold;
}

.djinn-badge-active {
    background-color: rgba(0, 255, 136, 0.15);
    border-color: rgba(0, 255, 136, 0.8);
}

.djinn-badge-active .djinn-status-badge-text {
    color: rgb(0, 255, 136);
}

.djinn-badge-standby {
    background-color: rgba(255, 215, 0, 0.15);
    border-color: rgba(255, 215, 0, 0.8);
}

.djinn-badge-standby .djinn-status-badge-text {
    color: rgb(255, 215, 0);
}

.djinn-badge-recovery {
    background-color: rgba(231, 76, 60, 0.15);
    border-color: rgba(231, 76, 60, 0.8);
}

.djinn-badge-recovery .djinn-status-badge-text {
    color: rgb(255, 107, 107);
}

.card-djinn-standby {
    opacity: 0.65;
}

.card-djinn-recovery {
    opacity: 0.45;
}

.main-djinn-body {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    border-radius: 4px;
    border-width: 1px;
    height: 95px;
    min-height: 95px;
    box-sizing: border-box;
}

.main-djinn-name-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    width: 100%;
    overflow: hidden;
}

.djinn-none-border {
    border-color: rgba(255, 255, 255, 0.05);
}

.djinn-none-bg {
    background-color: rgba(10, 10, 15, 0.5);
}

.main-djinn-full-icon {
    width: 70px;
    height: 70px;
    border-radius: 4px;
    margin-right: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(5, 5, 10, 0.6);
    flex-shrink: 0;
}

.main-djinn-details {
    flex-grow: 1;
    width: 0;
    flex-direction: column;
    justify-content: center;
    height: 100%;
}

.main-djinn-name-label {
    font-size: 12px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.main-djinn-ability-label {
    font-size: 9.5px;
    color: rgb(221, 221, 221);
    white-space: normal;
}

.passive-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.12);
    margin-top: 3px;
    margin-bottom: 3px;
}

.main-djinn-body .passive-title-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-accent-blue);
    margin-bottom: 1px;
}

.passive-desc-label {
    font-size: 10px;
    color: rgb(170, 170, 170);
    white-space: normal;
}