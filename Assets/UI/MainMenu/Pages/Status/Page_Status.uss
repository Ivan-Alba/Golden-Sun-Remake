/* ==========================================
   PAGE STATUS CONTAINER & CARDS
   ========================================== */
.page-status-container {
    flex-direction: row;
    justify-content: center;
    align-items: center; /* Centra las tarjetas recortadas verticalmente */
    flex-grow: 1;
    height: 100%;
    padding: 10px;
    color: #FFFFFF;
}

.hero-card {
    width: 23.5%;
    margin: 0 6px;
    background-color: rgba(15, 20, 28, 0.85);
    border-width: 2px;
    border-color: #2e3a4e;
    border-radius: 6px;
    padding: 10px;
    position: relative;
    overflow: hidden;
    color: #FFFFFF;
    /* Elimina el estiramiento vertical forzado */
    height: auto;
}

.card-face {
    position: relative; /* Cambiado de absolute a relative para colapsar alto exacto */
    width: 100%;
    height: auto;
    padding: 0;
    display: flex;
    flex-direction: column;
}

.page-status-container Label {
    color: #FFFFFF;
    margin: 0;
    padding: 0;
}

/* CENTRADO Y DISTRIBUCIÓN UNIFORME */
.card-front {
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    height: auto;
}

/* ==========================================
   1. HERO TOP SECTION (PORTRAIT & HEADER)
   ========================================== */
.hero-top-section {
    width: 100%;
    align-items: center;
    justify-content: flex-start;
    position: relative;
    border-radius: 5px;
    overflow: hidden;
    background-color: rgba(15, 15, 20, 0.6);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 6px 4px 4px 4px;
    margin-bottom: 6px;
}

.hero-portrait {
    width: 140px;
    height: 140px;
    aspect-ratio: 1;
    background-color: rgba(40, 40, 50, 0.9);
    border-radius: 4px;
    border-width: 2px;
    border-color: rgba(218, 165, 32, 0.4);
    margin-bottom: 6px;
}

.hero-header-info {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 4px 6px;
    background-color: rgba(10, 10, 15, 0.7);
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.12);
}

.hero-name-label {
    width: 45px;
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: #FFFFFF;
    flex-shrink: 0;
}

.hero-level-label {
    width: 45px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: #DAA520;
    flex-shrink: 0;
}

/* BARRA DE EXP CENTRADA Y EXPANDIBLE EN LA MISMA FILA */
.exp-bar-wrapper {
    width: 50%;
    position: relative;
    margin: 0 8px;
    height: 14px;
    justify-content: center;
    align-items: center;
}

.exp-bar-header {
    width: 100%;
    height: 14px;
    border-radius: 3px;
    margin: 0;
    padding: 0;
    background-color: rgba(10, 20, 35, 0.9);
    border-width: 1px;
    border-color: rgba(66, 165, 245, 0.5);
    overflow: hidden;
}

.exp-bar-header .unity-progress-bar__container {
    height: 100%;
    min-height: 12px;
    max-height: 12px;
    background-color: transparent;
    margin: 0;
    padding: 0;
}

.exp-bar-header .unity-progress-bar__background {
    background-color: rgba(12, 25, 45, 0.85);
    border-radius: 0;
    border-width: 0;
    height: 100%;
    margin: 0;
    padding: 0;
}

.exp-bar-header .unity-progress-bar__progress {
    background-color: #1E88E5;
    border-radius: 0;
    margin: 0;
    padding: 0;
    height: 100%;
}

.exp-bar-text {
    position: absolute;
    font-size: 8px;
    -unity-font-style: bold;
    color: #FFFFFF;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
    -unity-text-align: middle-center;
}

/* ==========================================
   2. STAT BARS CONTAINER (PV & PP)
   ========================================== */
.bars-container {
    width: 100%;
    flex-direction: column;
    margin-bottom: 6px;
}

.stat-bar-box {
    width: 100%;
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 6px;
    flex-shrink: 0;
}

.bar-label-text {
    font-size: 12px;
    -unity-font-style: bold;
    text-align: center;
    -unity-text-align: upper-center;
    color: #E0E0E0;
    margin-bottom: 3px;
    width: 100%;
    display: flex;
}

.custom-bar {
    height: 14px;
    border-radius: 3px;
    margin: 0;
    padding: 0;
    width: 100%;
}

.custom-bar .unity-progress-bar__container {
    height: 100%;
    min-height: 14px;
    max-height: 14px;
}

.custom-bar .unity-progress-bar__background {
    background-color: rgba(10, 10, 15, 0.8);
    border-radius: 3px;
    border-width: 0;
    height: 100%;
}

.hp-bar .unity-progress-bar__progress {
    background-color: #2ECC71;
    border-radius: 3px;
}

.pp-bar .unity-progress-bar__progress {
    background-color: #3498DB;
    border-radius: 3px;
}

/* ==========================================
   3. SECTION BOX & HEADERS
   ========================================== */
.section-box {
    width: 100%;
    background-color: rgba(15, 15, 20, 0.6);
    border-radius: 5px;
    padding: 6px 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    margin-bottom: 6px;
}

.page-status-container .section-header-label {
    font-size: 10px;
    -unity-font-style: bold;
    color: #DAA520;
    margin-bottom: 6px;
}

/* ==========================================
   4. MAIN STATS GRID (2x2)
   ========================================== */
.stats-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.stat-grid-item {
    width: 48%;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(25, 25, 35, 0.6);
    border-radius: 3px;
    padding: 3px 5px;
    margin-bottom: 4px;
}

.stat-icon {
    width: 11px;
    height: 11px;
    margin-right: 4px;
    border-radius: 2px;
}

.stat-grid-name {
    font-size: 11px;
    color: #CCCCCC;
    flex-grow: 1;
}

.stat-grid-val {
    font-size: 11px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.icon-attack { background-color: #E74C3C; }
.icon-defense { background-color: #3498DB; }
.icon-agility { background-color: #2ECC71; }
.icon-luck { background-color: #F1C40F; }

/* ==========================================
   5. ELEMENTAL AFFINITY TABLE
   ========================================== */
.element-table-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.element-col-titles {
    flex-direction: row;
}

.elem-col-title {
    font-size: 9px;
    -unity-font-style: bold;
    color: #AAAAAA;
    width: 28px;
    text-align: center;
}

.element-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 2px 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.05);
}

.element-name {
    font-size: 11px;
    color: #E0E0E0;
    flex-grow: 1;
    margin-left: 6px;
}

.element-val {
    font-size: 11px;
    color: #FFFFFF;
    width: 28px;
    text-align: center;
}

.icon-venus { background-color: #C88A2E; border-color: rgba(255, 255, 255, 0.4); }
.icon-mars { background-color: #E74C3C; border-color: rgba(255, 255, 255, 0.4); }
.icon-jupiter { background-color: #9B59B6; border-color: rgba(255, 255, 255, 0.4); }
.icon-mercury { background-color: #3498DB; border-color: rgba(255, 255, 255, 0.4); }

/* ==========================================
   6. BOTTOM UNIFIED CONTAINER (NEUTRAL OUTER BOX)
   ========================================== */
.main-djinn-card {
    width: 100%;
    flex-direction: column;
    background-color: rgba(15, 15, 20, 0.6);
    border-radius: 5px;
    padding: 6px 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    transition-property: opacity;
    transition-duration: 0.2s;
}

.class-djinn-bar {
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.hero-class-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: #FFD700;
}

.equipped-pips-row {
    flex-direction: row;
    align-items: center;
}

.pip-element-group {
    flex-direction: row;
    align-items: center;
    margin-left: 5px;
}

.pip-icon {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    margin-right: 2px;
    border-width: 1px;
}

.pip-count {
    font-size: 10px;
    -unity-font-style: bold;
    color: #E0E0E0;
}

.djinn-card-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.08);
    margin-bottom: 5px;
}

.djinn-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.page-status-container .djinn-header-label {
    margin-bottom: 0;
}

/* STATUS BADGES */
.status-badge {
    padding: 1px 6px;
    border-radius: 3px;
    border-width: 1px;
}

.status-badge-text {
    font-size: 8.5px;
    -unity-font-style: bold;
}

.badge-active {
    background-color: rgba(0, 255, 136, 0.15);
    border-color: rgba(0, 255, 136, 0.8);
}
.badge-active .status-badge-text { color: #00FF88; }

.badge-standby {
    background-color: rgba(255, 215, 0, 0.15);
    border-color: rgba(255, 215, 0, 0.8);
}
.badge-standby .status-badge-text { color: #FFD700; }

.badge-recovery {
    background-color: rgba(231, 76, 60, 0.15);
    border-color: rgba(231, 76, 60, 0.8);
}
.badge-recovery .status-badge-text { color: #FF6B6B; }

/* DYNAMIC OPACITY BY STATE */
.card-djinn-standby {
    opacity: 0.65;
}

.card-djinn-recovery {
    opacity: 0.45;
}

/* ==========================================
   7. INNER DJINN CARD (THE ENVELOPING CARD)
   ========================================== */
.main-djinn-body {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    border-radius: 4px;
    border-width: 1px;
    /* Altura fija para garantizar alineación exacta en las 4 hero cards */
    height: 78px;
    min-height: 78px;
    box-sizing: border-box;
}

/* Elemental Borders & Card Backgrounds for main-djinn-body */
.djinn-venus-border { border-color: rgba(200, 138, 46, 0.7); }
.djinn-mars-border { border-color: rgba(231, 76, 60, 0.7); }
.djinn-jupiter-border { border-color: rgba(155, 89, 182, 0.7); }
.djinn-mercury-border { border-color: rgba(52, 152, 219, 0.7); }

.djinn-venus-bg { background-color: rgba(200, 138, 46, 0.12); }
.djinn-mars-bg { background-color: rgba(231, 76, 60, 0.12); }
.djinn-jupiter-bg { background-color: rgba(155, 89, 182, 0.12); }
.djinn-mercury-bg { background-color: rgba(52, 152, 219, 0.12); }

/* ESTILO DISCRETO Y OSCURO PARA DJINN SIN ASIGNAR */
.djinn-none-border { 
    border-color: rgba(255, 255, 255, 0.05); 
}

.djinn-none-bg { 
    background-color: rgba(10, 10, 15, 0.5); 
}

.main-djinn-full-icon {
    width: 50px;
    height: 50px;
    border-radius: 4px;
    margin-right: 8px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    background-color: rgba(5, 5, 10, 0.6);
    flex-shrink: 0;
}

.main-djinn-details {
    flex-grow: 1;
    width: 0;
    flex-direction: column;
    justify-content: center;
    height: 100%;
}

.main-djinn-name-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: #FFD700;
    margin-bottom: 2px;
}

.main-djinn-ability-label {
    font-size: 9.5px;
    color: #DDDDDD;
    white-space: normal;
}

.passive-divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.12);
    margin-top: 3px;
    margin-bottom: 3px;
}

.passive-title-label {
    font-size: 10.5px;
    -unity-font-style: bold;
    color: #60A5FA;
    margin-bottom: 1px;
}

.passive-desc-label {
    font-size: 9px;
    color: #AAAAAA;
    white-space: normal;
}