/* ==========================================================================
   Page_Psynergy.uss
   Specific styles for the Psynergy Page (Hero Portrait & D-Pad Shortcuts)
   ========================================================================== */

/* --- LEFT PANEL SPECIFICS: HERO PORTRAIT & D-PAD CROSS --- */
.hero-portrait-box {
    width: 100%;
    align-items: center;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.hero-portrait-image {
    width: 72px;
    height: 72px;
    background-color: #1A2332;
    border-width: 2px;
    border-color: var(--color-gold-sun);
    border-radius: 36px;
    margin-bottom: 6px;
}

.hero-name-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-text-white);
    -unity-text-align: middle-center;
}

.section-separator {
    width: 90%;
    height: 2px;
    background-color: var(--color-panel-border);
    margin-top: 5px;
    margin-bottom: 15px;
    flex-shrink: 0;
}

/* --- D-PAD CROSS LAYOUT --- */
.dpad-shortcuts-container {
    width: 100%;
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.dpad-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
}

.dpad-row-horizontal {
    margin-top: 5px;
    margin-bottom: 5px;
}

.shortcut-slot {
    width: 70px;
    height: 70px;
    background-color: #121924;
    border-width: 2px;
    border-color: #4A5A73;
    border-radius: 8px;
    align-items: center;
    justify-content: center;
    position: relative;
}

.shortcut-slot:hover {
    border-color: var(--color-gold-sun);
    background-color: #1A2536;
}

.dpad-arrow-label {
    position: absolute;
    top: 2px;
    left: 4px;
    font-size: 10px;
    color: #6A7B95;
}

.shortcut-icon {
    width: 36px;
    height: 36px;
}

.dpad-center-decor {
    width: 24px;
    height: 24px;
    background-color: #1B2636;
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--color-panel-border);
    margin-left: 6px;
    margin-right: 6px;
}

/* --- CENTER PANEL SPECIFICS: FILTER TABS & SCROLL CONTAINER --- */
.filter-tabs-row {
    flex-direction: row;
    width: 100%;
    margin-top: 4px;
    margin-bottom: 12px;
    flex-shrink: 0;
}

.tab-btn {
    flex-grow: 1;
    height: 30px;
    background-color: #141C28;
    border-width: 1px;
    border-color: var(--color-panel-border);
    border-radius: 4px;
    color: var(--color-text-muted);
    font-size: 12px;
    -unity-font-style: bold;
    margin-right: 4px;
}

.tab-btn:hover {
    background-color: #1D2A3D;
    color: var(--color-text-white);
}

.tab-btn.active {
    background-color: #2B3D59;
    border-color: var(--color-gold-sun);
    color: var(--color-text-white);
}

.psynergy-cards-scroll {
    flex-grow: 1;
    width: 100%;
    padding-right: 5px;
}

.psynergy-cards-scroll .psynergy-card {
    width: 49%;
}

.psynergy-cards-scroll #unity-content-container {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
}