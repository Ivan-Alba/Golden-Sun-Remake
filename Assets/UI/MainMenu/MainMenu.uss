/* ==========================================
   MAIN MENU BOOK CONTAINER
   ========================================== */
#container_book {
    flex-direction: column;
    justify-content: space-between;
    position: absolute;
    left: 4%;
    right: 4%;
    top: 4%;
    bottom: 4%;
    width: auto;
    height: auto;
    background-color: rgba(18, 18, 22, 0.92);
    border-width: 2px;
    border-radius: 12px;
    padding: 10px;
    color: #FFFFFF;
    overflow: hidden;
}

.container-book Label {
    margin: 0;
    padding: 0;
}


/* ==========================================
   HEADER SECTION & 3-COLUMN INFO BAR
   ========================================== */
#header_top {
    background-color: rgba(30, 30, 38, 0.85);
    border-radius: 8px;
    padding: 10px 16px;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    flex-shrink: 0;
}

.header-info-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

/* Common Generic Icon Base Style */
.header-icon {
    width: 22px;
    height: 22px;
    margin-right: 6px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    flex-shrink: 0;
}

/* Placeholders icons */
.icon-chapter {
    background-color: rgba(255, 215, 0, 0.15);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 215, 0, 0.4);
}

.icon-quest {
    background-color: rgba(96, 165, 250, 0.15);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(96, 165, 250, 0.4);
}

.icon-location {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.icon-gold {
    background-color: rgba(255, 215, 0, 0.15);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 215, 0, 0.4);
}

.icon-time {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

/* ------------------------------------------
   HEADER COLUMN 1: LEFT BOX (28% EQUALIZED)
   ------------------------------------------ */
.header-left-box {
    width: 28%;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
}

.djinn-tracker-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 3px;
    margin-bottom: 3px;
}

/* Strict Width Lock for Column Alignment */
.djinn-element-group {
    width: 48%;
    flex-direction: row;
    align-items: center;
}

.djinn-pips-container {
    flex-direction: row;
    align-items: center;
    margin-right: 4px;
}

/* Small Elemental Pip (Gem) */
.djinn-pip {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
    margin-right: 2px;
}

.djinn-pip.active {
    background-color: #FFD700;
    border-color: #FFFFFF;
}

.djinn-count-text {
    font-size: 13px;
    color: #AAAAAA;
    min-width: 16px;
}

/* Djinn Element Icons */
.icon-djinn-venus { background-color: rgba(200, 138, 46, 0.7); border-radius: 3px; }
.icon-djinn-mars { background-color: rgba(231, 76, 60, 0.7); border-radius: 3px; }
.icon-djinn-jupiter { background-color: rgba(155, 89, 182, 0.7); border-radius: 3px; }
.icon-djinn-mercury { background-color: rgba(52, 152, 219, 0.7); border-radius: 3px; }

/* ------------------------------------------
   HEADER COLUMN 2: CENTER BOX (44% PERFECT CENTER)
   ------------------------------------------ */
.header-center-box {
    width: 44%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.chapter-info-row {
    flex-direction: row;
    align-items: center;
    margin-top: 1px;
    margin-bottom: 5px;
}

.quest-info-row {
    flex-direction: row;
    align-items: center;
    margin-top: 1px;
    margin-bottom: 1px;
}

.label-chapter {
    font-size: 22px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.label-quest {
    font-size: 17px;
    -unity-font-style: bold;
    color: #60A5FA;
}

/* ------------------------------------------
   HEADER COLUMN 3: RIGHT BOX (28% EQUALIZED)
   ------------------------------------------ */
.header-right-box {
    width: 28%;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
}

.header-info-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 2px;
    margin-top: 1px
}

.row-right {
    justify-content: flex-end;
    width: 100%;
}

.label-location-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.label-gold-text {
    font-size: 13px;
    -unity-font-style: normal;
    color: #FFD700;
}

.label-time-text {
    font-size: 13px;
    -unity-font-style: normal;
    color: #FFFFFF;
}

/* ==========================================
   HERO SELECTION HEADER BAR
   ========================================== */
.header-heroes-bar {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: flex-start;
    align-items: center;
    margin-top: 8px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
}

.header-hero-card {
    width: 23.5%;
    height: 50px;
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin-right: 1.5%;
    background-color: rgba(35, 35, 45, 0.85);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    transition-duration: 0.15s;
    justify-content: flex-start;
}

.header-hero-card:hover {
    background-color: rgba(50, 50, 65, 0.95);
    border-color: rgba(218, 165, 32, 0.6);
}

.header-hero-card:active,
.header-hero-card:focus {
    border-color: #FFD700;
    background-color: rgba(60, 50, 30, 0.85);
}

.header-hero-card.active {
    border-color: #FFD700;
    border-width: 2px;
    background-color: rgba(60, 50, 30, 0.95);
}

.header-hero-card.active .header-hero-name {
    color: #FFD700;
}

.header-hero-portrait {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    background-color: rgba(20, 20, 20, 0.8);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    margin-right: 8px;
}

.header-hero-info {
    flex-grow: 1;
    width: 0;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
}

.header-hero-top-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
}

.header-hero-name {
    font-size: 14px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.header-hero-level {
    font-size: 11px;
    color: #94A3B8;
}


.header-hero-stats-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

.header-hero-stats-row .header-hero-stat-box {
    flex-grow: 0;
    width: 48%; /* Reparte el ancho equitativamente con un pequeño margen central */
}

.header-hero-stat-text {
    font-size: 11px;
    color: #CCCCCC;
    padding: 0;
    margin: 0 0 2px 0;
}

.header-hero-bar-bg {
    height: 8px;
    min-height: 8px;
    width: 100%;
    flex-shrink: 0;
    background-color: rgba(10, 10, 10, 0.9);
    border-radius: 3px;
    overflow: hidden;
}

.header-hero-bar-fill {
    height: 100%;
    min-height: 100%;
    border-radius: 3px;
}

.hp-bar-fill { background-color: #2ECC71; }
.pp-bar-fill { background-color: #3498DB; }

/* ==========================================
   PAGE CONTENT CONTAINER
   ========================================== */
#page_content {
   flex-grow: 1;          /* Takes up all remaining vertical space dynamically */
    flex-shrink: 1;        /* Adapts smoothly if header components toggle visibility */
    min-height: 0;         /* CRITICAL: Prevents internal elements from pushing the box height */
    width: 100%;
    overflow: hidden;      /* Clips subpage layout overflow cleanly */
    position: relative;

    background-color: rgba(25, 25, 30, 0.5);
    border-radius: 8px;
    margin-top: 0px;
    margin-bottom: 0px;
    padding: 4px;
}

/* Regla UNIVERSAL en MainMenu.uss para bloquear CUALQUIER página/submenú instanciado */
#page_content > TemplateContainer,
#page_content > VisualElement {
    width: 100%;
    height: 100%;
    max-height: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    overflow: hidden;
}

/* ==========================================
   BOTTOM CONTROL PROMPTS BAR
   ========================================== */
.control-prompts-bar {
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    background-color: rgba(15, 15, 20, 0.85);
    border-width: 1px;
    border-color: rgba(218, 165, 32, 0.25);
    border-radius: 6px;
    padding: 0 12px;
    margin-top: 4px;
    margin-bottom: 4px;
    height: 32px;
    flex-shrink: 0;
}

.prompt-text {
    font-size: 13px;
    -unity-font-style: bold;
    color: #CCCCCC;
    letter-spacing: 0.5px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

/* ==========================================
   BOOKMARK TABS
   ========================================== */
.bookmarks-bar {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: space-between;
    align-items: center;
    margin-top: 6px;
    width: 100%;
}

.bookmark-tab {
    width: 19%;
    height: 92px;                /* Subimos de 82px a 92px */
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 6px;
    background-color: rgba(35, 35, 45, 0.9);
    border-width: 1px;
    border-color: rgba(218, 165, 32, 0.4);
    border-radius: 8px;
    transition-duration: 0.15s;
}

.bookmark-tab:hover {
    background-color: rgba(218, 165, 32, 0.35);
    border-color: #FFD700;
}

.bookmark-tab:active,
.bookmark-tab:focus,
.bookmark-tab.active {           /* Pestaña seleccionada */
    background-color: #DAA520;
    border-color: #FFFFFF;
}

/* Icono con soporte para animación y escala */
.bookmark-icon {
    width: 54px;                 /* Subimos de 46px a 54px */
    height: 54px;
    background-color: rgba(15, 15, 20, 0.6);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    margin-bottom: 4px;
    background-size: 85%;
    background-position: center;
    background-repeat: no-repeat;
    
    /* Transición fluida para el efecto Golden Sun */
    transition-property: scale, translate;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

/* EFECTO GOLDEN SUN: Al estar activo o en hover, el icono resalta */
.bookmark-tab.active .bookmark-icon {
    scale: 1.12;                /* Crece un 12% suavemente */
    translate: 0 -2px;          /* Se eleva 2px hacia arriba */
    border-color: #FFD700;
    background-color: rgba(20, 20, 25, 0.9);
}

.bookmark-text {
    font-size: 13px;            /* Subimos de 12px a 13px */
    -unity-font-style: bold;
    color: #DDDDDD;
    text-align: center;
    padding: 0;
    margin: 0;
}

.bookmark-tab:hover .bookmark-text { color: #FFFFFF; }
.bookmark-tab:active .bookmark-text,
.bookmark-tab.active .bookmark-text { color: #121216; }