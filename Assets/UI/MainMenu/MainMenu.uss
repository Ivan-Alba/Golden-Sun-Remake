/* ==========================================
   MAIN MENU BOOK CONTAINER
   ========================================== */
#container_book {
    background-color: rgba(18, 18, 22, 0.92);
    border-width: 2px;
    border-color: rgba(218, 165, 32, 0.6); /* Golden frame border */
    border-radius: 12px;
    padding: 10px;
    color: #FFFFFF;
}


/* ==========================================
   HEADER SECTION & 3-COLUMN INFO BAR
   ========================================== */
#header_top {
    background-color: rgba(30, 30, 38, 0.85);
    border-radius: 8px;
    padding: 8px 14px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(218, 165, 32, 0.3);
}

.header-info-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
}

/* Common Generic Icon Base Style */
.header-icon {
    width: 18px;
    height: 18px;
    margin-right: 6px;
    background-size: contain;
    background-position: center;
    background-repeat: no-repeat;
    flex-shrink: 0;
}

/* Placeholders */
.icon-chapter {
    background-color: rgba(255, 215, 0, 0.15);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 215, 0, 0.4);
}

.icon-quest {
    background-color: rgba(96, 165, 250, 0.15);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(96, 165, 250, 0.4);
}

.icon-location {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.icon-gold {
    background-color: rgba(255, 215, 0, 0.15);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 215, 0, 0.4);
}

.icon-time {
    background-color: rgba(255, 255, 255, 0.1);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
}

.header-info-row {
    flex-direction: row;
    align-items: center;
    margin-top: 1px;
    margin-bottom: 1px;
}

.header-info-label {
    font-size: 12px;
    -unity-font-style: normal;
    color: #CCCCCC;
    margin: 0;
    padding: 0;
}

/* ------------------------------------------
   HEADER COLUMN 1: LEFT BOX (28% EQUALIZED)
   ------------------------------------------ */
.header-left-box {
    width: 28%;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
}

.djinn-tracker-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    margin-top: 2px;
    margin-bottom: 2px;
}

/* Strict Width Lock for Column Alignment */
.djinn-element-group {
    width: 48%;
    flex-direction: row;
    align-items: center;
}

.djinn-pips-container {
    flex-direction: row;
    align-items: center;
    margin-right: 4px;
}

/* Small Elemental Pip (Gem) */
.djinn-pip {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.15);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.3);
    margin-right: 1px;
}

.djinn-pip.active {
    background-color: #FFD700;
    border-color: #FFFFFF;
}

.djinn-count-text {
    font-size: 10px;
    color: #AAAAAA;
    margin: 0;
    padding: 0;
    min-width: 16px; /* Prevents layout shifting when double digits occur */
}

/* Djinn Element Icons */
.icon-djinn-venus { background-color: rgba(46, 204, 113, 0.3); border-radius: 3px; }
.icon-djinn-mars { background-color: rgba(231, 76, 60, 0.3); border-radius: 3px; }
.icon-djinn-jupiter { background-color: rgba(241, 196, 15, 0.3); border-radius: 3px; }
.icon-djinn-mercury { background-color: rgba(52, 152, 219, 0.3); border-radius: 3px; }

/* ------------------------------------------
   HEADER COLUMN 2: CENTER BOX (44% PERFECT CENTER)
   ------------------------------------------ */
.header-center-box {
    width: 44%;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.label-chapter {
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    margin: 0;
    padding: 0;
}

.label-quest {
    font-size: 15px;
    -unity-font-style: bold;
    color: #60A5FA;
    margin: 0;
    padding: 0;
}

/* ------------------------------------------
   HEADER COLUMN 3: RIGHT BOX (28% EQUALIZED)
   ------------------------------------------ */
.header-right-box {
    width: 28%;
    flex-direction: column;
    justify-content: center;
    align-items: flex-end;
}

.row-right {
    justify-content: flex-end;
    width: 100%;
}

.label-location-text {
    font-size: 13px;
    -unity-font-style: bold;
    color: #FFFFFF;
}

.label-gold-text {
    font-size: 12px;
    -unity-font-style: normal;
    color: #FFD700;
}

.label-time-text {
    font-size: 11px;
    -unity-font-style: normal;
    color: #AAAAAA;
}

/* ==========================================
   HERO SELECTION HEADER BAR
   ========================================== */
.header-heroes-bar {
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    margin-top: 8px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.1);
}

.header-hero-card {
    width: 23.5%;
    height: 84px;
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    margin-right: 1.5%;
    background-color: rgba(35, 35, 45, 0.85);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    transition-duration: 0.15s;
    justify-content: flex-start;
}

.header-hero-card:hover {
    background-color: rgba(50, 50, 65, 0.95);
    border-color: rgba(218, 165, 32, 0.6);
}

.header-hero-card:active,
.header-hero-card:focus {
    border-color: #FFD700;
    background-color: rgba(60, 50, 30, 0.85);
}

.header-hero-card.active {
    border-color: #FFD700;
    border-width: 2px;
    background-color: rgba(60, 50, 30, 0.95);
}

.header-hero-card.active .header-hero-name {
    color: #FFD700;
}

.header-hero-portrait {
    width: 58px;
    height: 66px;
    flex-shrink: 0;
    background-color: rgba(20, 20, 20, 0.8);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    margin-right: 8px;
}

.header-hero-info {
    flex-grow: 1;
    width: 0;
    flex-direction: column;
    justify-content: space-between;
    height: 100%;
}

.header-hero-top-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-shrink: 0;
}

.header-hero-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: #FFFFFF;
    padding: 0;
    margin: 0;
}

.header-hero-level {
    font-size: 11px;
    color: #DAA520;
    padding: 0;
    margin: 0;
}

.header-hero-stat-box {
    flex-direction: column;
    width: 100%;
    flex-shrink: 0;
}

.header-hero-stat-text {
    font-size: 10px;
    color: #CCCCCC;
    padding: 0;
    margin: 0 0 2px 0;
}

.header-hero-bar-bg {
    height: 6px;
    min-height: 6px;
    width: 100%;
    flex-shrink: 0;
    background-color: rgba(10, 10, 10, 0.9);
    border-radius: 3px;
    overflow: hidden;
}

.header-hero-bar-fill {
    height: 100%;
    min-height: 100%;
    border-radius: 3px;
}

.hp-bar-fill { background-color: #2ECC71; }
.pp-bar-fill { background-color: #3498DB; }

/* ==========================================
   PAGE CONTENT CONTAINER
   ========================================== */
#page_content {
    background-color: rgba(25, 25, 30, 0.5);
    border-radius: 8px;
    margin-top: 4px;
    margin-bottom: 4px;
    padding: 4px;
}

/* ==========================================
   BOTTOM CONTROL PROMPTS BAR
   ========================================== */
.control-prompts-bar {
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
    background-color: rgba(15, 15, 20, 0.85);
    border-width: 1px;
    border-color: rgba(218, 165, 32, 0.25);
    border-radius: 6px;
    padding: 0 12px;
    margin-top: 4px;
    margin-bottom: 4px;
    height: 28px;
    flex-shrink: 0;
}

.prompt-text {
    font-size: 11px;
    -unity-font-style: bold;
    color: #CCCCCC;
    letter-spacing: 0.5px;
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

/* ==========================================
   BOOKMARK TABS
   ========================================== */
.bookmarks-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-top: 8px;
    width: 100%;
}

.bookmark-tab {
    width: 19%;
    height: 82px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 6px;
    background-color: rgba(35, 35, 45, 0.9);
    border-width: 1px;
    border-color: rgba(218, 165, 32, 0.4);
    border-radius: 8px;
    transition-duration: 0.15s;
}

.bookmark-tab:hover {
    background-color: rgba(218, 165, 32, 0.35);
    border-color: #FFD700;
}

.bookmark-tab:active,
.bookmark-tab:focus {
    background-color: #DAA520;
    border-color: #FFFFFF;
}

.bookmark-icon {
    width: 46px;
    height: 46px;
    background-color: rgba(15, 15, 20, 0.6);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    margin-bottom: 4px;
    background-size: 85%;
    background-position: center;
    background-repeat: no-repeat;
}

.bookmark-text {
    font-size: 12px;
    -unity-font-style: bold;
    color: #DDDDDD;
    text-align: center;
    padding: 0;
    margin: 0;
}

.bookmark-tab:hover .bookmark-text { color: #FFFFFF; }
.bookmark-tab:active .bookmark-text { color: #121216; }