@import url("project://database/Assets/UI/Global_theme.uss");

.transition-root {
    position: absolute;
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

/* Ambient Screen Fade Overlay */
.fade-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.4s;
    transition-timing-function: ease-out;
}

/* Base Doors (Solid & Tight) */
.door {
    position: absolute;
    top: 0;
    width: 50.5%;
    height: 100%;
    background-color: var(--color-panel-bg-no-alpha);
    transition-property: translate;
    transition-duration: 0.8s;
    transition-timing-function: ease-in-out-cubic;
}

.door-left {
    left: 0;
    translate: 0 0;
}

.door-right {
    right: 0;
    translate: 0 0;
}

.door-open-left {
    translate: -101% 0;
}

.door-open-right {
    translate: 101% 0;
}

/* Central Emblem (Sun) */
.center-emblem {
    position: absolute;
    width: 300px;
    height: 300px;
    background-size: contain;
    background-repeat: no-repeat;
    background-position: center;
    transition-property: scale, rotate, opacity;
    transition-duration: 0.6s;
    transition-timing-function: ease-out-back;
    scale: 1 1;
    rotate: 0deg;
    opacity: 1;
}

.emblem-hidden {
    scale: 0 0;
    rotate: -180deg;
    opacity: 0;
}