/* =========================================================================
   BattleHUD.uss
   Styles for Battle HUD, Turn Timeline, Target Overlays & Action Submenus
   Matches the design system and variables defined in PlayerHUD.uss / Global_theme.uss
   ========================================================================= */

/* --- Root Container & Layers --- */
.battle-hud-root {
    width: 100%;
    height: 100%;
    position: absolute;
    left: 0;
    top: 0;
    justify-content: space-between;
    align-items: stretch;
}

/* Layer Management */
.hud-layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    
    transition-property: opacity;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
    opacity: 1;
}

.hud-layer--hidden {
    opacity: 0;
}

/* =========================================================================
   1. TOP-LEFT: ACTIVE HERO CLOSE-UP VIEWPORT
   ========================================================================= */

.portrait-viewport-frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 960px;
    height: 540px;
    background-color: transparent;
    overflow: visible;

    transform-origin: top left;

    /* Transition for full screen corner exit/entrance */
    transition-property: scale, opacity, translate;
    transition-duration: 0.5s;
    transition-timing-function: ease;
    opacity: 1;
    scale: 1 1;
    translate: 0 0;
}

/* Hidden state: Collapses to 0 scale and travels 100% out of bounds to the top-left corner */
.portrait-viewport-frame--hidden {
    opacity: 0;
    scale: 0 0;
    translate: -100% -100%;

    /* Transición para SALIR: Desaparición suave y progresiva */
    transition-duration: 0.4s;
    transition-timing-function: linear;
}

.portrait-viewport-render {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
}

.active-hero-badge-label {
    position: absolute;
    bottom: 32px;
    left: 32px;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
    background-color: var(--color-subbox-bg);
    border-color: var(--color-gold-sun);
    border-width: 1.5px;
    border-radius: 6px;
    padding: 3px 12px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
}

/* =========================================================================
   2. TOP-CENTER: ACTIVE ACTION / BANNER DISPLAY
   ========================================================================= */
.action-banner-container {
    position: absolute;
    top: 36px;
    left: 32%;
    right: 32%;
    align-items: center;

    /* ENTRADA (SHOW): Despliegue suave con un ligero rebote elástico */
    transition-property: opacity, translate, scale;
    transition-duration: 0.6s;
    transition-timing-function: ease;
    opacity: 1;
    translate: 0 0;
    scale: 1 1;
}

.action-banner-container--hidden {
    /* SALIDA (HIDE): Sube 100% hacia arriba fuera de cuadro y se reduce */
    opacity: 0;
    translate: 0 -100%;
    scale: 0.9 0.9;

    /* Sobreescribimos la salida para que sea rápida y limpia */
    transition-duration: 0.3s;
    transition-timing-function: linear;
}

.action-banner-card {
    background-color: var(--color-panel-bg, rgba(12, 18, 28, 0.92));
    border-color: var(--color-gold-sun, #d4af37);
    border-width: 2px;
    border-radius: 10px;
    padding: 8px 24px;
    width: 100%;
    align-items: center;
    justify-content: center;
}

.action-banner-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--color-gold-bright, #ffe680);
    letter-spacing: 1.5px;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.95);
    margin: 0;
    padding: 0;
}

.action-banner-subtext {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-text-white, #ffffff);
    margin-top: 2px;
    margin-bottom: 0;
    padding: 0;
}

/* =========================================================================
   3. FLOATING OVERLAYS: TARGET SELECTION INFO CARDS
   ========================================================================= */
.target-overlay-root {
    position: absolute;
    top: 0;
    left: 0;
    margin: 0;
    padding: 0;
}

/* =========================================================================
   4. TOP-RIGHT: TURN TIMELINE / ACTION QUEUE
   ========================================================================= */
.turn-timeline-container {
    position: absolute;
    top: 36px;
    right: 36px;
    width: auto;
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border);
    border-width: 2px;
    border-radius: 12px;
    padding: 10px 14px 18px 14px;
    align-items: flex-start;

    /* Transition for full panel entrance */
    transition-property: opacity, translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    opacity: 1;
    translate: 0 0;
}

.turn-timeline-container--hidden {
    opacity: 0;
    translate: 30px 0;
}

.timeline-title-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
    letter-spacing: 2px;
    margin-bottom: 8px;
}

.turn-timeline-row {
    flex-direction: row;
    align-items: flex-end;
}

.turn-leader-slot {
    margin-right: 10px;
    justify-content: flex-end;
    align-items: center;
}

.turn-queue-list {
    flex-direction: row;
    align-items: flex-end;
}

.timeline-slot-wrapper {
    position: relative;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
}

.timeline-slot-wrapper.queue-wrapper {
    margin-right: 8px;
}

.timeline-icon-box {
    width: 52px;
    height: 52px;
    margin: 0;
    justify-content: center;
    align-items: center;
    border-width: 1.5px;
    border-color: rgba(255, 255, 255, 0.4);
    border-radius: 8px;
    overflow: hidden;
}

.timeline-portrait-img {
    width: 100%;
    height: 100%;
}

.current-turn-leader {
    width: 78px;
    height: 78px;
    margin: 0;
    border-width: 3.5px;
    border-color: #ffcc00;
    border-radius: 12px;
    overflow: hidden;
    scale: 1 1;
    
    transition-property: scale, border-color;
    transition-duration: 0.4s;
    transition-timing-function: ease-in-out;
}

.current-turn-leader--pulse {
    scale: 1.06 1.06;
    border-color: #ffe680;
}

.timeline-target-indicator {
    position: absolute;
    bottom: -14px;
    width: 9px;
    height: 9px;
    background-color: #c084fc;
    border-color: #f3e8ff;
    border-width: 1px;
    border-radius: 2px;
    rotate: 45deg;
    
    transition-property: opacity, scale, translate, background-color;
    transition-duration: 0.25s;
    transition-timing-function: ease-in-out;
}

.timeline-target-indicator--bounce {
    translate: 0 -3px;
    background-color: #e9d5ff;
}

.timeline-target-indicator--hidden {
    opacity: 0;
    scale: 0 0;
}

/* =========================================================================
   5. FLOATING CENTER: COMMAND CROSS MENU ANCHOR
   ========================================================================= */
.floating-command-menu-container {
    position: absolute;
    top: 0;
    left: 0;
}

/* =========================================================================
   6. SCREEN CENTER: QTE / TIMING OVERLAY
   ========================================================================= */
.qte-overlay-container {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

/* =========================================================================
   7. BOTTOM-LEFT: HERO STATUS CARDS CONTAINER
   ========================================================================= */
.party-cards-battle-container {
    position: absolute;
    left: 44px;
    bottom: 44px;
    flex-direction: column;
    align-items: flex-start;
    scale: 0.85;
    transform-origin: bottom left;

    transition-property: opacity, translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
    opacity: 1;
    translate: 0 0;
}

.party-cards-battle-container--hidden {
    opacity: 0;
    translate: -30px 0;
}

/* =========================================================================
   8. BOTTOM-RIGHT: ACTION DETAILS SUBMENU PANEL
   ========================================================================= */
.action-details-panel {
    position: absolute;
    bottom: 44px;
    right: 44px;
    width: 380px;
    height: 260px;
    background-color: var(--color-panel-bg);
    border-color: var(--color-panel-border);
    border-width: 2.5px;
    border-radius: 14px;
    padding: 16px;
    display: none;
}

.details-title-label {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
    letter-spacing: 1.5px;
    margin-bottom: 10px;
    border-bottom-width: 1.5px;
    border-bottom-color: var(--color-gold-sun);
    padding-bottom: 4px;
}

.details-list-scroll {
    flex-grow: 1;
    margin-bottom: 10px;
}

.action-description-box {
    background-color: var(--color-subbox-bg);
    border-color: var(--color-subbox-border);
    border-width: 1.5px;
    border-radius: 8px;
    padding: 8px 12px;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.action-description-text {
    font-size: 13px;
    color: var(--color-text-white);
    flex-grow: 1;
    white-space: normal;
    margin: 0;
    padding: 0;
}

.action-cost-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-accent-blue);
    margin-left: 12px;
    margin: 0;
    padding: 0;
}

/* =========================================================================
   9. RESULTS OVERLAY: DRAGON QUEST STYLE DIALOG & LEVEL UP
   ========================================================================= */
.results-dialog-container {
    position: absolute;
    bottom: 48px;
    left: 15%;
    right: 15%;
    height: 110px;
    background-color: var(--color-panel-bg, rgba(12, 18, 28, 0.95));
    border-color: var(--color-gold-sun, #d4af37);
    border-width: 2.5px;
    border-radius: 12px;
    padding: 16px 24px;
    justify-content: center;
    align-items: flex-start;

    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
    opacity: 1;
    translate: 0 0;
}

.results-dialog-container--hidden {
    opacity: 0;
    translate: 0 20px;
}

.results-dialog-text {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-text-white, #ffffff);
    white-space: normal;
    letter-spacing: 0.8px;
    margin: 0;
    padding: 0;
}

.results-prompt-indicator {
    position: absolute;
    bottom: 12px;
    right: 20px;
    width: 12px;
    height: 12px;
    background-color: var(--color-gold-bright, #ffe680);
    rotate: 45deg;
}

.level-up-overlay-container {
    position: absolute;
    top: 20%;
    right: 10%;
    width: 320px;

    transition-property: opacity, scale;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-back;
    opacity: 1;
    scale: 1 1;
}

.level-up-overlay-container--hidden {
    opacity: 0;
    scale: 0.8 0.8;
}

.level-up-card {
    background-color: var(--color-panel-bg, rgba(12, 18, 28, 0.95));
    border-color: var(--color-gold-sun, #d4af37);
    border-width: 2.5px;
    border-radius: 14px;
    padding: 16px 20px;
    align-items: center;
}

.levelup-title-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--color-gold-bright, #ffe680);
    letter-spacing: 1.2px;
    margin-bottom: 12px;
    border-bottom-width: 1.5px;
    border-bottom-color: var(--color-gold-sun, #d4af37);
    padding-bottom: 4px;
    width: 100%;
    -unity-text-align: middle-center;
}

.levelup-stats-grid {
    width: 100%;
    flex-direction: column;
}

.levelup-stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.levelup-stat-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--color-text-white, #ffffff);
}

.levelup-stat-value {
    font-size: 15px;
    -unity-font-style: bold;
    color: #4ade80; /* Soft green */
}