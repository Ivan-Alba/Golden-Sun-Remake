/* =========================================================================
   CommandCrossOverlay.uss
   Styles for the Battle Floating Command Cross & Horizontal Pill Special Wings
   ========================================================================= */

.command-cross-root {
    position: absolute;
    width: 380px;
    height: 380px;
    align-items: center;
    justify-content: center;
    translate: -50% -50%;

    /* Smooth Fade & Elastic Scale Transition for Show/Hide */
    transition-property: opacity, scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
    opacity: 1;
    scale: 1 1;
}

/* Hidden state for smooth Fade-Out & Scale-Down */
.command-cross-root--hidden {
    opacity: 0;
    scale: 0.7 0.7;
}

/* --- Unified Keycap Badges --- */
.cmd-key-badge {
    position: absolute;
    top: -5px;
    left: -5px;
    min-width: 20px;
    height: 20px;
    background-color: var(--color-subbox-bg, #0a0e16);
    border-color: var(--color-gold-bright, #ffe680);
    border-width: 1.5px;
    border-radius: 5px;
    padding: 0 4px;
    align-items: center;
    justify-content: center;
}

.label-cmd-key {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--color-gold-bright, #ffe680);
    margin: 0;
    padding: 0;
}

/* --- UPPER SPECIAL WINGS (Horizontal Pill Layout) --- */
.wings-container {
    position: absolute;
    top: 30px; /* Positioned parallel to the top slot of the cross */
    width: 100%;
    flex-direction: row;
    justify-content: space-between;
    padding: 0 4px;
}

.wing-slot {
    flex-direction: row;
    align-items: center;
    height: 38px;
    padding: 0 12px 0 10px;
    background-color: var(--color-panel-bg, rgba(12, 18, 28, 0.92));
    border-color: var(--color-gold-sun, #d4af37);
    border-width: 2px;
    border-radius: 19px; /* Pill/Capsule shape geometry */
    position: relative;

    /* Smooth transition for focus and scale */
    transition-property: scale, border-color, background-color, opacity;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

/* Specific styling and padding adjustments for Djinn and Summon slots */
.wing-slot--djinn {
    border-color: #38bdf8; /* Cyan accent border for Djinn */
}

.wing-slot--summon {
    border-color: #f43f5e; /* Crimson/Magenta accent border for Summon */
    padding: 0 10px 0 12px;
}

/* Hover & Focus Interaction States */
.wing-slot:enabled:hover, .wing-slot:enabled.wing-slot--focused {
    scale: 1.12;
    background-color: rgba(28, 44, 68, 0.98);
}

.wing-slot--djinn:enabled:hover, .wing-slot--djinn:enabled.wing-slot--focused {
    border-color: #7dd3fc;
}

.wing-slot--summon:enabled:hover, .wing-slot--summon:enabled.wing-slot--focused {
    border-color: #fb7185;
}

.wing-icon {
    width: 24px;
    height: 24px;
    margin-right: 6px;
    -unity-background-scale-mode: scale-to-fit;
}

.wing-slot--summon .wing-icon {
    margin-right: 0;
    margin-left: 6px;
}

.wing-text-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--color-text-white, #ffffff);
    letter-spacing: 0.8px;
    margin: 0;
    padding: 0;
}

.wing-key-badge {
    top: -6px;
}

.wing-slot--djinn .wing-key-badge { 
    left: -6px; 
}

.wing-slot--summon .wing-key-badge { 
    right: -6px; 
    left: auto; 
}

/* --- MAIN COMMAND DPAD WHEEL (Expanded Radial Spacing & 64x64px Slots) --- */
.dpad-cmd-wheel {
    width: 380px;
    height: 380px;
    position: relative;
    align-items: center;
    justify-content: center;
    margin-top: 20px;
}

.dpad-slot {
    width: 64px;
    height: 64px;
    position: absolute;
    background-color: var(--color-panel-bg, rgba(12, 18, 28, 0.9));
    border-color: var(--color-gold-sun, #d4af37);
    border-width: 2px;
    border-radius: 14px;
    align-items: center;
    justify-content: center;

    /* Elastic animation transition for in/out focus */
    transition-property: scale, border-color, background-color, opacity, filter;
    transition-duration: 0.15s;
    transition-timing-function: ease-out-back;
}

/* Selected / Focused State (Keyboard Hotkey, WASD, or Mouse Hover) */
.dpad-slot:enabled:hover, .dpad-slot:enabled.dpad-slot--focused {
    scale: 1.22;
    border-color: var(--color-gold-bright, #ffe680);
    background-color: rgba(38, 58, 88, 0.95);
}

/* --- DISABLED STATES FOR SLOTS & WINGS --- */
.dpad-slot:disabled,
.dpad-slot.cmd-slot--disabled,
.wing-slot:disabled,
.wing-slot.cmd-slot--disabled {
    opacity: 0.45;
    border-color: #4a5568;
    background-color: rgba(15, 20, 28, 0.8);
    scale: 1 1;
}

.dpad-slot:disabled .cmd-key-badge,
.dpad-slot.cmd-slot--disabled .cmd-key-badge,
.wing-slot:disabled .wing-key-badge,
.wing-slot.cmd-slot--disabled .wing-key-badge {
    border-color: #718096;
    background-color: #1a202c;
}

.dpad-slot:disabled .label-cmd-key,
.dpad-slot.cmd-slot--disabled .label-cmd-key,
.wing-slot:disabled .wing-text-label,
.wing-slot.cmd-slot--disabled .wing-text-label {
    color: #a0aec0;
}

/* Cross Layout Offsets */
.slot-up { top: 0; }
.slot-down { bottom: 0; }
.slot-left { left: 0; }
.slot-right { right: 0; }

.cmd-icon {
    width: 38px;
    height: 38px;
    -unity-background-scale-mode: scale-to-fit;
}

.icon-attack { background-image: url("project://database/Assets/Resources/Images/cmd_attack.png"); }
.icon-psynergy { background-image: url("project://database/Assets/Resources/Images/cmd_psynergy.png"); }
.icon-item { background-image: url("project://database/Assets/Resources/Images/cmd_item.png"); }
.icon-defend { background-image: url("project://database/Assets/Resources/Images/cmd_defend.png"); }
.icon-djinn { background-image: url("project://database/Assets/Resources/Images/cmd_djinn.png"); }
.icon-summon { background-image: url("project://database/Assets/Resources/Images/cmd_summon.png"); }

.dpad-center-gem {
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background-color: var(--color-gold-bright, #ffe680);
    border-width: 1.5px;
    border-color: #000000;
}

/* Action Name Badge attached beneath each D-Pad slot */
.cmd-action-label {
    position: absolute;
    bottom: -18px;
    font-size: 10px;
    -unity-font-style: bold;
    color: var(--color-gold-bright, #ffe680);
    background-color: rgba(10, 14, 22, 0.85);
    border-color: var(--color-gold-sun, #d4af37);
    border-width: 1px;
    border-radius: 4px;
    padding: 1px 6px;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.95);
    letter-spacing: 0.5px;
}

/* Central Active Command Badge (Optional Contextual Overlay) */
.cmd-selected-badge {
    position: absolute;
    bottom: -18px;
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--color-gold-bright, #ffe680);
    background-color: var(--color-subbox-bg, rgba(10, 14, 22, 0.9));
    border-color: var(--color-gold-sun, #d4af37);
    border-width: 1.5px;
    border-radius: 6px;
    padding: 3px 14px;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.95);
    letter-spacing: 1px;
    
    transition-property: scale, opacity;
    transition-duration: 0.12s;
}

/* Hidden state for central badge when not in use */
.cmd-selected-badge--hidden {
    opacity: 0;
    scale: 0.8 0.8;
}