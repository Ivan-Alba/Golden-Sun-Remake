/* =========================================================================
   Common_Layouts.uss
   Reusable Layout Structures, 3-Column Chassis, Headings & Custom Scrollbars
   ========================================================================= */

/* --- 1. Root Container for 3-Column Subpages --- */
.page-three-columns-container {
    width: 100%;
    height: 100%;
    max-height: 100%;
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
    flex-direction: row;
    padding: 6px;
    overflow: hidden;
}

.page-three-columns-container Label {
    margin: 0;
    padding: 0;
}

/* --- 2. Shared Section Titles --- */
.page-three-columns-container .info-title-label,
.container-book .info-title-label,
.page-djinn-container .info-title-label {
    font-size: 17px;
    -unity-font-style: bold;
    color: var(--color-gold-sun);
    margin-bottom: 12px;
    -unity-text-align: middle-center;
    letter-spacing: 1px;
    flex-shrink: 0;
}

/* --- 3. Unified 3-Column Flex System (25% / 45% / 30%) --- */

/* Left Panel (Ratio 25) */
.panel-column-left {
    flex-grow: 25;
    flex-shrink: 0;
    flex-basis: 0;
    height: 100%;
    max-height: 100%;
    padding: 10px;
    background-color: var(--color-panel-bg);
    border-width: 2px;
    border-color: var(--color-panel-border);
    border-radius: 6px;
    flex-direction: column;
    align-items: center;
    margin-right: 10px;
    overflow: hidden;
}

/* Center Panel (Ratio 45) */
.panel-column-center {
    flex-grow: 45;
    flex-shrink: 0;
    flex-basis: 0;
    height: 100%;
    max-height: 100%;
    padding: 10px;
    background-color: var(--color-panel-bg);
    border-width: 2px;
    border-color: var(--color-panel-border);
    border-radius: 6px;
    margin-right: 10px;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
}

/* Right Panel (Ratio 30) */
.panel-column-right {
    flex-grow: 30;
    flex-shrink: 0;
    flex-basis: 0;
    height: 100%;
    max-height: 100%;
    padding: 10px;
    background-color: var(--color-panel-bg);
    border-width: 2px;
    border-color: var(--color-panel-border);
    border-radius: 6px;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
}

/* --- 4. Right Panel Preview Header Layout --- */
.detail-preview-container {
    width: 120px;
    height: 120px;
    background-color: #0D131D;
    border-width: 1px;
    border-color: #253347;
    border-radius: 6px;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
    flex-shrink: 0;
}

.detail-preview-icon {
    width: 120px;
    height: 120px;
    background-color: rgba(255, 255, 255, 0.05);
    border-width: 3px;
    border-color: rgba(218, 165, 32, 0.5);
    border-radius: 8px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

/* Wide Box for Video / Animated Renders (Psynergy, Djinn) */
.detail-preview-container-wide { 
    width: 100%; 
    height: 160px;                    /* Altura ideal para encajar un aspect ratio 16:9 */
    padding: 6px;                     /* Margin/Padding interno uniforme */
    background-color: #0D131D; 
    border-width: 1px; 
    border-color: #253347; 
    border-radius: 6px; 
    align-items: center; 
    justify-content: center; 
    margin-bottom: 8px; 
    flex-shrink: 0; 
}

.detail-preview-render { 
    width: 100%; 
    height: 100%; 
    background-color: rgba(0, 0, 0, 0.4); 
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    border-radius: 4px; 
    flex-shrink: 0; 
    overflow: hidden;                 /* Recorta el vídeo o render si sobresale */
}

.detail-icon-name-row {
    align-items: center;
    flex-direction: row;
    justify-content: center;
    width: 100%;
    height: auto;

}

.detail-icon-name-row .pip-icon,
.summary-hero-box .pip-icon {
    width: 15px;
    height: 15px;
    margin-right: 5px;
}

.page-three-columns-container .detail-name-label,
.container-book .detail-name-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--color-text-white);
    -unity-text-align: middle-center;
    flex-shrink: 0;
}

.page-three-columns-container .detail-type-label,
.container-book .detail-type-label {
    font-size: 14px;
    color: var(--color-accent-blue);
    -unity-text-align: middle-center;
    margin-bottom: 8px;
    margin-top: 8px;
    flex-shrink: 0;
}

.detail-meta-row {
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
    background-color: #121A26;
    padding: 6px 8px;
    border-radius: 4px;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.panel-column-right .detail-meta-label {
    font-size: 13px;
}

.detail-desc-container {
    width: 100%;
    padding: 0 6px;
    margin-bottom: 10px;
    flex-shrink: 0;
}

.page-three-columns-container .detail-desc-label,
.container-book .detail-desc-label {
    font-size: 15px;
    color: var(--color-text-description);
    white-space: normal;
    margin-bottom: 6px;
    -unity-text-align: upper-left;
    flex-shrink: 0;
}

/* --- 5. Extra Info Custom ScrollView & Scroller --- */
.extra-info-container {
    flex-grow: 1;
    flex-shrink: 1;
    width: 100%;
    height: 0;
    min-height: 0;
    overflow: hidden;
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

/* Forzar al viewport interno de Unity a usar el 100% del ancho */
.extra-info-container .unity-scroll-view__content-viewport {
    width: 100%;
    align-items: stretch;
}

/* Forzar al contenedor interno del ScrollView a expandirse al 100% */
.extra-info-container .unity-scroll-view__content-container {
    width: 100%;
    align-items: stretch;
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}

.scroll-inner-card {
    background-color: var(--color-subbox-bg);
    border-width: 1px;
    border-color: var(--color-subbox-border);
    border-radius: 4px;
    padding: 6px 8px;
    margin-right: 4px;
}

/* Scroller Component Overrides */
.extra-info-container .unity-scroller--vertical,
.extra-info-container .unity-scroller--vertical .unity-base-slider {
    width: 6px;
    min-width: 6px;
    margin: 0;
    padding: 0;
}

.extra-info-container .unity-scroller__low-button,
.extra-info-container .unity-scroller__high-button {
    display: none;
    width: 0;
    height: 0;
}

.extra-info-container .unity-base-slider__tracker {
    width: 6px;
    min-width: 6px;
    background-color: rgba(10, 15, 24, 0.8);
    border-width: 1px;
    border-color: rgba(31, 45, 64, 0.6);
    border-radius: 3px;
    margin: 0;
}

.extra-info-container .unity-base-slider__dragger {
    width: 6px;
    min-width: 6px;
    left: 0;
    background-color: rgba(218, 165, 32, 0.8);
    border-width: 1px;
    border-color: rgba(255, 215, 0, 0.9);
    border-radius: 3px;
}

.extra-info-container .unity-base-slider__dragger:hover {
    background-color: var(--color-gold-bright);
}

.extra-info-container .unity-base-slider__dragger:active {
    background-color: #FFA500;
}


.container-book .unleash-name-label {
    font-size: 14px;
    color: var(--color-accent-blue);
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.container-book .unleash-desc-label {
    font-size: 13px;
    color: var(--color-text-description);
    white-space: normal;
    margin-bottom: 2px;

}

/* =========================================================================
   6. REUSABLE PSYNERGY CARD COMPONENT (Fluid Width & Optional Interaction)
   ========================================================================= */

/* Base Component (Passive / Non-Interactive by Default) */
.psynergy-card {
    flex-direction: row;
    height: 52px;
    width: 100%;                       /* Full width by default for flexible containers */
    background-color: var(--color-subbox-bg);
    border-width: 2px;
    border-color: #253347;
    border-radius: 6px;
    align-items: center;
    padding-right: 10px;
    margin-bottom: 3px;
    overflow: hidden;
}

.psynergy-card.interactive:focus {
    background-color: #25354E;
}

/* Optional Interactive Modifiers (Use for lists, selection menus or battle) */
.psynergy-card.interactive:hover {
    background-color: #1A2538;
    border-color: var(--color-gold-sun);
}

.psynergy-card.interactive:active {
    background-color: #25354E;
}


/* Card Internal Layout Elements */
.card-element-stripe {
    width: 5px;
    height: 100%;
    background-color: var(--color-none);
}

.card-icon-box {
    width: 44px;
    height: 44px;
    justify-content: center;
    align-items: center;
    margin-left: 8px;
}

.psynergy-card-icon {
    width: 36px;
    height: 36px;
}

.card-text-details {
    flex-grow: 1;
    height: 100%;
    justify-content: center;
    margin-left: 8px;
}

.card-title-row {
    flex-direction: row;
    align-items: center;
}

.psynergy-card-name {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--color-text-white);
    margin: 0;
    padding: 0;
}

.card-badges-row {
    flex-direction: row;
    align-items: center;
    margin-top: 3px;
}

.card-cost-box {
    flex-direction: row;
    align-items: center;
}

.element-mini-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
}

.psynergy-card-pp {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--color-accent-blue);
}

/* --- Psynergy Card Badges (World, Battle, Menu) --- */
.container-book .psynergy-badge {
    font-size: 11px;
    padding: 2px 6px;
    margin-right: 2px;
    border-radius: 3px;
    color: var(--color-text-white);
    -unity-font-style: bold;
}

.badge-world {
    background-color: #2874A6;
}

.badge-battle {
    background-color: #B03A2E;
}

.badge-menu {
    background-color: #1E8449;
}

/* Elemental Card Stripes & Borders */
.element-venus .card-element-stripe { background-color: var(--color-venus); }
.element-venus { border-color: var(--color-venus); }
.element-venus-bg { background-color: var(--color-venus-bg); }

.element-mars .card-element-stripe { background-color: var(--color-mars); }
.element-mars { border-color: var(--color-mars); }
.element-mars-bg { background-color: var(--color-mars-bg); }

.element-jupiter .card-element-stripe { background-color: var(--color-jupiter); }
.element-jupiter { border-color: var(--color-jupiter); }
.element-jupiter-bg { background-color: var(--color-jupiter-bg); }

.element-mercury .card-element-stripe { background-color: var(--color-mercury); }
.element-mercury { border-color: var(--color-mercury); }
.element-mercury-bg { background-color: var(--color-mercury-bg); }

/* Gained / Lost Psynergies */
.card-status-box {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.page-djinn-container .badge-psy-status {
    font-size: 10px;
    -unity-font-style: bold;
    padding: 3px 5px;
    border-radius: 3px;
    -unity-text-align: middle-right;
}

.badge-gained {
    color: #00FF88;
    background-color: rgba(0, 255, 136, 0.2);
    border-width: 1px;
    border-color: rgba(0, 255, 136, 0.4);
}

.badge-lost {
    color: #FF6B6B;
    background-color: rgba(255, 107, 107, 0.2);
    border-width: 1px;
    border-color: rgba(255, 107, 107, 0.4);
}

.psy-card-new {
    border-color: rgba(0, 255, 136, 0.5);
    background-color: rgba(0, 255, 136, 0.05);
}

.psy-card-lost {
    background-color: rgba(255, 68, 68, 0.05);
    border-color: rgba(255, 68, 68, 0.3);
}

.stripe-lost { background-color: #FF4444; }
.text-lost { color: #FF8888; }

/* ==========================================================================
   LOCKED OVERLAY LAYER (Tapa todo el contenido en tonos grises)
   ========================================================================== */
.lock-overlay {
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    background-color: #141921;
    border-color: #4A5668;
    border-width: 2px;
    border-radius: 6px;
    flex-direction: row;
    align-items: center;
    overflow: hidden; /* Fuerza a que la franja respete el border-radius de 6px */
    display: none; /* Oculto por defecto */
}

/* Franja izquierda neutra gris alineada al milímetro */
.stripe-lock-overlay {
    width: 5px;
    height: 100%;
    background-color: #4A5668;
    flex-shrink: 0;
}

/* Icono de Candado en la posición equivalente al icono original */
.icon-lock-symbol {
    width: 36px;
    height: 36px;
    background-color: #6C7A8E;
    border-radius: 3px;
}

/* Detalles del texto de bloqueo */
.lock-text-details {
    flex-direction: column;
    justify-content: center;
    margin-left: 6px;
    flex-grow: 1;
}

.lock-subtitle {
    font-size: 7.5px;
    -unity-font-style: bold;
    color: #6C7A8E;
    letter-spacing: 0.5px;
}

.lock-level-text {
    font-size: 10.5px;
    -unity-font-style: bold;
    color: #94A3B8;
}

.psy-card-locked {
    background-color: rgba(12, 16, 23, 0.5);
    border-color: rgba(255, 255, 255, 0.05);
}

.stripe-locked { background-color: #4A5A73; }
.text-locked { color: #6A7B95; }
.icon-lock { background-color: rgba(0, 0, 0, 0.4); }


/* =========================================================================
   7. PAGE ITEMS EXTRA INFO TEMPLATES (SHARED CARDS & STATS)
   ========================================================================= */

/* --- Card Root Wrapper --- */
.extra-info-card-root {
    width: 100%;                  /* Fuerza a ocupar el 100% del ancho */
    height: auto;
    align-self: stretch;
    flex-grow: 0;
    flex-shrink: 0;
    justify-content: flex-start;
    padding: 10px;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
}

/* --- Visual Separator Line --- */
.info-divider {
    height: 1px;
    width: 100%;
    background-color: rgba(255, 255, 255, 0.1);
    margin-top: 8px;
    margin-bottom: 8px;
}

/* --- Section Subheaders (Gold Accent) --- */
.container-book .section-header-title,
.extra-info-card-root .section-header-title,
.page-status-container .section-header-title,
.djinn-summary-panel .section-header-title, 
.page-djinn-container .section-header-title {
    font-size: 11.5px;
    flex-shrink: 0;
    color: var(--color-gold-sun);
    -unity-font-style: bold;
    letter-spacing: 1px;
    margin-top: 2px;
    margin-bottom: 4px;
}

/* --- Badges System (Usage & Element Chips) --- */
.badge-row-container {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.item-badge {
    flex-direction: row;
    align-items: center;
    padding: 4px 10px;
    border-radius: 10px;
    background-color: rgba(20, 20, 20, 0.7);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.15);
}

.badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 3px;
    margin-right: 5px;
    background-color: var(--color-none);
}

.extra-info-card-root .badge-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--color-text-muted);
}

/* Badge States */
.badge-active {
    border-color: rgba(255, 215, 0, 0.8);
    background-color: rgba(255, 215, 0, 0.12);
    opacity: 1;
}

.badge-active .badge-dot {
    background-color: #00FF88;
}

.badge-active .badge-label {
    color: var(--color-text-white);
}

.badge-inactive {
    opacity: 0.5;
}

/* --- Item Compact Base Stat Rows --- */
.item-stats-box {
    margin-bottom: 2px;
}

.item-stats-grid {
    flex-direction: column;
}

.item-stat-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
}

.item-stat-name {
    font-size: 13px;
}

.item-stat-value {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-text-white);
}

.item-stat-zero {
    color: #666666;
}

/* --- Item Delta Stat Comparison Rows --- */
.item-comparison-box {
    margin-top: 2px;
}

.item-comparison-container {
    flex-direction: column;
}

.item-comparison-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
}

.item-delta-container {
    flex-direction: row;
    align-items: center;
}

.item-current-value {
    font-size: 14px;
    color: #AAAAAA;
}

.extra-info-card-root .arrow-separator {
    font-size: 12px;
    color: #666666;
    margin-left: 4px;
    margin-right: 4px;
}

.item-new-value {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-text-white);
}

.extra-info-card-root .item-delta-tag {
    font-size: 13px;
    -unity-font-style: bold;
    margin-left: 5px;
}

/* Delta Value Colors */
.delta-positive { color: #00FF88; }
.delta-negative { color: #FF4444; }
.delta-neutral  { color: #888888; }


/* --- Lore & Flavor Narrative Box --- */
.lore-box {
    justify-content: center;
    align-items: center;
    padding: 6px 10px;
    background-color: rgba(15, 15, 20, 0.4);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.05);
    margin-top: 2px;
}

.quote-mark {
    width: 12px;
    height: 2px;
    background-color: rgba(218, 165, 32, 0.5);
    margin-top: 2px;
    margin-bottom: 2px;
}

.extra-info-card-root .lore-text {
    font-size: 12px;
    -unity-font-style: italic;
    color: #D3C399;
    -unity-text-align: middle-center;
    white-space: normal;
    padding: 3px 0;
}

/* =========================================================================
   HERO SUMMARY HEADER (UI TEMPLATE)
   ========================================================================= */

.hero-header-instance {
    width: 100%;
    flex-grow: 0;
    flex-shrink: 0;
}

.summary-hero-box {
    flex-direction: row;
    width: 100%;
    height: auto;
    flex-grow: 0;
    align-self: stretch;
    align-items: center;
    background-color: rgba(20, 29, 44, 0.9);
    border-radius: 4px;
    padding: 6px;
    margin-bottom: 6px;
    border-width: 1px;
    border-color: #2e3a4e;
    flex-shrink: 0;
}

.summary-hero-avatar-box {
    width: 80px;
    height: 80px;
    background-color: rgba(0, 0, 0, 0.4);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    justify-content: center;
    align-items: center;
    margin-right: 6px;
    flex-shrink: 0;
}

.summary-hero-avatar-icon {
    width: 95%;
    height: 95%;
}

.summary-hero-info-box {
    flex-grow: 1;
    height: 100%;
    justify-content: space-between;
    padding-top: 2px;
    padding-bottom: 2px;
    overflow: hidden;
}

.summary-hero-title-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2px;
}

.summary-hero-name {
    font-size: 18px;
    -unity-font-style: bold;
    color: var(--color-gold-bright);
    margin: 0;
    padding: 0;
}

.summary-hero-column-level {
    font-size: 14px;
    color: #94A3B8;
}


/* Contenedor vertical para el bloque de nivel */
.summary-hero-level-box {
    flex-direction: column;
    align-items: center; /* Centra horizontalmente el label de nivel respecto a la barra */
    justify-content: center;
}

/* Forzar que el label no tenga márgenes que desalineen */
.summary-hero-level-box .summary-hero-column-level {
    margin: 0;
    padding: 0;
    -unity-text-align: middle-center;
}

/* Estilo para la minibarra de EXP */
.summary-exp-bar {
    width: 50px;       /* Ancho compacto ajustado al texto Nv. XX */
    height: 4px;       /* Barrita ultra fina sutil */
    margin-top: 2px;
}

/* 1. Limpiar el contenedor interno de Unity */
.summary-exp-bar .unity-progress-bar__container {
    min-height: 4px;
    max-height: 4px;
    height: 4px;
}

/* 2. Forzar altura estricta en fondo y progreso, y anular flex-grow */
.summary-exp-bar .unity-progress-bar__background {
    background-color: rgba(0, 0, 0, 0.6);
    border-width: 0;
    border-radius: 2px;
    height: 4px;
    min-height: 4px;
    max-height: 4px;
}

.summary-exp-bar .unity-progress-bar__progress {
    background-color: #9b59b6;
    border-radius: 2px;
    height: 4px;
    min-height: 4px;
    max-height: 4px;
}


.summary-class-name-container {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin-top: 2px;
    margin-bottom: 6px;
    flex-grow: 0;
    flex-shrink: 0;
}

.summary-hero-box .summary-class-title {
    font-size: 15px;
    width: auto;
    -unity-font-style: bold;
    color: #00FF88;
    letter-spacing: 0.5px;
    background-color: rgba(10, 16, 26, 0.75);
    border-width: 1px;
    border-color: rgba(218, 165, 32, 0.4);
    border-radius: 4px;
    padding: 2px 8px;
}

.summary-hero-box .summary-class-arrow {
    font-size: 15px;
    width: auto;
    color: var(--color-text-muted);
    margin-left: 4px;
    margin-right: 4px;
}

.summary-pips-row {
    flex-direction: row;
    width: 100%;
    height: auto;
    justify-content: flex-start;
    align-items: center;
    margin: 0;
    flex-grow: 0;
    flex-shrink: 0;
}

.summary-pip-element-group {
    flex-direction: row;
    align-items: center;
    margin-right: 8px;
}

.pip-count {
    font-size: 14px;
    -unity-font-style: bold;
    color: #E0E0E0;
    width: 25px;
}



/* =========================================================================
   CHARACTER STATS GRID (UI TEMPLATE)
   ========================================================================= */
.summary-stats-container {
    width: 100%;
    flex-direction: column;
    flex-shrink: 0;
    margin-bottom: 4px;
}

.stats-grid {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-start;
    align-content: flex-start;
    flex-shrink: 0;
    margin-bottom: 2px;
}

.stat-item {
    flex: 0 0 48%;
    height: 19px;
    min-height: 19px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    background-color: rgba(25, 25, 35, 0.6);
    border-radius: 3px;
    padding: 0 6px;
    margin-bottom: 3px;
}

.stat-label-group {
    flex-direction: row;
    align-items: center;
}

.stat-icon {
    width: 12px;
    height: 12px;
    margin-right: 5px;
    border-radius: 2px;
}

.stat-name {
    font-size: 13px;
    color: #CCCCCC;
    -unity-font-style: bold;
}

.stat-val {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-text-white);
}

.stat-value-group {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.page-djinn-container .stat-delta,
.container-book .stat-delta {
    font-size: 12px;
    -unity-font-style: bold;
    margin-left: 3px;
}

.delta-positive { color: #00FF88; }
.delta-negative { color: #FF4444; }

.icon-max-hp { background-color: #2ECC71; }
.icon-max-pp { background-color: #3498DB; }
.icon-attack { background-color: #E74C3C; }
.icon-defense { background-color: #574725; }
.icon-agility { background-color: #A32BBA; }
.icon-luck { background-color: #F1C40F; }


/* =========================================================================
   ELEMENTAL AFFINITY GRID (UI TEMPLATE) - REFACTOR LAYOUT
   ========================================================================= */

.elemental-affinity-container {
    width: 100%;
    flex-direction: column;
    flex-shrink: 0;
    margin-bottom: 2px;
}

/* Layout contenedor para 2x2 */
.elemental-grid-2x2 {
    flex-direction: row;
    justify-content: space-between;
    width: 100%;
}

/* Cada columna ocupa el 48% del espacio */
.elemental-grid-col {
    flex-direction: column;
    width: 48%;
}

.element-row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between; /* Empuja el nombre a la izq y las stats a la der */
    padding: 2px 0;
}

/* Nombre del elemento: Ancho flexible pero no invasivo */
.element-name {
    font-size: 13px;
    margin-left: 6px;
    color: var(--color-text-white);
    flex-grow: 1;
}

/* Grupo par etiqueta-valor (P: 100) */
.elem-stat-group {
    flex-direction: row;
    align-items: center;
    margin-left: 8px;
}

/* Prefijo sutil P: o R: */
.elem-stat-group .elem-prefix-label {
    font-size: 11px;
    color: #8899A6;
    margin-right: 3px;
    -unity-font-style: bold;
}

/* Valor numérico: Ajustado a la derecha sin espacio residual al final */
.element-val {
    font-size: 13px;
    color: var(--color-text-white);
    width: auto;         /* Eliminamos los 28px fijos centrados */
    min-width: 22px;     /* Reserva espacio mínimo para alineación perfecta */
    -unity-text-align: middle-right;   /* Alineación estricta a la derecha */
}

/* =========================================================================
   8. REUSABLE
   ========================================================================= */

/* --- Summary Psynergies Scroll Container --- */
.summary-psynergy-view-container {
    width: 100%;
    flex-grow: 1;
    height: 0;
    min-height: 0;
    flex-direction: column;
}

/* ==========================================
   PSYNERGY COMPARISON FILTER TABS
   ========================================== */

.summary-psynergy-filter-tabs {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    padding-left: 2px;
    padding-right: 2px;
    width: 100%;
}

.mini-tab-btn {
    flex-grow: 1;
    margin-left: 2px;
    margin-right: 2px;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 4px;
    padding-right: 4px;
    font-size: 10px;
    -unity-font-style: bold;
    color: #A0A0A0;
    background-color: rgba(20, 20, 25, 0.6);
    border-width: 1px;
    border-color: #444444;
    border-radius: 3px;
    -unity-text-align: middle-center;
    transition-duration: 0.15s;
}

.mini-tab-btn:hover {
    background-color: rgba(40, 40, 50, 0.8);
    border-color: #777777;
    color: #FFFFFF;
}

.mini-tab-btn:active,
.mini-tab-btn.active {
    background-color: #2D3A45;
    border-color: #E6B800;
    color: #FFD700;
}

/* Modificadores específicos por categoría */

.mini-tab-btn.tab-gained:hover,
.mini-tab-btn.tab-gained.active {
    border-color: #2ECC71;
    color: #2ECC71;
    background-color: rgba(46, 204, 113, 0.15);
}

.mini-tab-btn.tab-lost:hover,
.mini-tab-btn.tab-lost.active {
    border-color: #E74C3C;
    color: #E74C3C;
    background-color: rgba(231, 76, 60, 0.15);
}

/* SUMMARY PSINERGY LIST SCROLL */
.summary-psynergy-list-scroll {
    width: 100%;
    flex-grow: 1;
    height: 0;
    min-height: 0;
    padding-right: 2px;
    padding-top: 2px;
}

/* Forzar al viewport interno de Unity a usar el 100% del ancho */
.summary-psynergy-list-scroll .unity-scroll-view__content-viewport {
    width: 100%;
    align-items: stretch;
}

/* Forzar al contenedor interno del ScrollView a expandirse al 100% */
.summary-psynergy-list-scroll .unity-scroll-view__content-container {
    width: 100%;
    align-items: stretch;
    flex-direction: column;
    flex-grow: 1;
}


/* Scroller Component Overrides */
.summary-psynergy-list-scroll .unity-scroller--vertical,
.summary-psynergy-list-scroll .unity-scroller--vertical .unity-base-slider {
    width: 6px;
    min-width: 6px;
    margin: 0;
    padding: 0;
}

.summary-psynergy-list-scroll .unity-scroller__low-button,
.summary-psynergy-list-scroll .unity-scroller__high-button {
    display: none;
    width: 0;
    height: 0;
}

.summary-psynergy-list-scroll .unity-base-slider__tracker {
    width: 6px;
    min-width: 6px;
    background-color: rgba(10, 15, 24, 0.8);
    border-width: 1px;
    border-color: rgba(31, 45, 64, 0.6);
    border-radius: 3px;
    margin: 0;
}

.summary-psynergy-list-scroll .unity-base-slider__dragger {
    width: 6px;
    min-width: 6px;
    left: 0;
    background-color: rgba(218, 165, 32, 0.8);
    border-width: 1px;
    border-color: rgba(255, 215, 0, 0.9);
    border-radius: 3px;
}

.summary-psynergy-list-scroll .unity-base-slider__dragger:hover {
    background-color: var(--color-gold-bright);
}

.summary-psynergy-list-scroll .unity-base-slider__dragger:active {
    background-color: #FFA500;
}

/* BADGES EFFECTS UNLEASH / PSYNERGY */

.unleash-status-effect-row {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    margin-top: 4px;
    margin-bottom: 4px;
}

/* Badge container */
.unleash-badge {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    flex-shrink: 0;
    height: 21px;
    padding: 2px 8px;
    border-radius: 3px;
    margin-right: 4px;
    margin-bottom: 4px;
    border-width: 1px;
}

.unleash-badge Label {
    font-size: 11.5px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.badge-target {
    color: #A0B0C0;
    background-color: rgba(160, 176, 192, 0.15);
    border-color: rgba(160, 176, 192, 0.3);
}

.badge-damage {
    color: #5DADE2;
    background-color: rgba(93, 173, 226, 0.15);
    border-color: rgba(93, 173, 226, 0.35);
}

.badge-buff {
    color: #2ECC71;
    background-color: rgba(46, 204, 113, 0.15);
    border-color: rgba(46, 204, 113, 0.35);
}

.badge-debuff {
    color: #E67E22;
    background-color: rgba(230, 126, 34, 0.15);
    border-color: rgba(230, 126, 34, 0.35);
}

.badge-ailment {
    color: #A569BD;
    background-color: rgba(165, 105, 189, 0.18);
    border-color: rgba(165, 105, 189, 0.4);
}

.badge-icon {
    width: 13px;
    height: 13px;
    min-width: 13px;
    min-height: 13px;
    max-width: 13px;
    max-height: 13px;
    margin-right: 4px;
    flex-grow: 0;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}
